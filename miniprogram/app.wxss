/* app.wxss - 暖调餐饮设计系统（参考餐饮品牌风格：辣椒红 + 米白 + 暖黑） */

/* ===== Light Mode CSS Variables ===== */
page {
  /* Colors - Light 暖色系 */
  --color-primary: #D93A2B;
  --color-primary-green: #2F9E6E;
  --color-primary-orange: #F0821E;
  --color-primary-red: #E02020;
  --color-primary-purple: #9B59B6;
  --color-primary-pink: #E8467C;

  --color-text-primary: #2B2118;
  --color-text-secondary: #6F6459;
  --color-text-tertiary: #A69A8B;

  --color-bg: #FFFDF9;
  --color-bg-secondary: #FAF6F0;
  --color-bg-tertiary: #F1E9DE;

  --color-card: #FFFFFF;
  --color-card-inner: #FAF3EA;
  --color-border: #EDE3D5;
  --color-separator: rgba(139, 110, 78, 0.14);

  --color-accent: #D93A2B;
  --color-accent-soft: rgba(217, 58, 43, 0.10);
  --color-accent-deep: #B42A1D;
  --color-gold: #E6A23C;
  --color-cream: #FDF3E3;

  /* 压在强调色渐变上的文字/图标色；金色等浅强调色需覆盖为深色（见 accent-gold） */
  --color-on-accent: #FFFFFF;
  /* 大数字专用：比 accent 深一档，保证金色等浅色系下依然可读 */
  --color-num-strong: var(--color-accent-deep);
  /* 菜品/头像图片压暗（深色模式置为 brightness(0.9)） */
  --img-filter: none;

  /* Spacing */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* Radius */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 40rpx;
  --radius-pill: 999rpx;

  /* Typography */
  --font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;

  /* Shadows 暖色阴影 */
  --shadow-card: 0 4rpx 16rpx rgba(160, 110, 60, 0.08);
  --shadow-float: 0 12rpx 48rpx rgba(160, 110, 60, 0.18);
  --shadow-accent: 0 8rpx 28rpx rgba(217, 58, 43, 0.32);

  background-color: var(--color-bg-secondary);
  color: var(--color-text-primary);
  font-family: var(--font-family);
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ===== Dark Mode 暖黑（非纯黑反色） ===== */
@media (prefers-color-scheme: dark) {
  page {
    --color-primary: #E8564A;
    --color-primary-green: #3DB584;
    --color-primary-orange: #F59543;
    --color-primary-red: #FF5A4E;
    --color-primary-purple: #B478C7;
    --color-primary-pink: #F06292;

    --color-text-primary: #F5EFE8;
    --color-text-secondary: #A89C8E;
    --color-text-tertiary: #8C8074;

    --color-bg: #17130F;
    --color-bg-secondary: #201B16;
    --color-bg-tertiary: #2C261F;

    --color-card: #2A241D;
    --color-card-inner: #352E25;
    --color-border: #3E362C;
    --color-separator: rgba(200, 180, 150, 0.14);

    --color-accent: #E8564A;
    --color-accent-soft: rgba(232, 86, 74, 0.16);
    --color-accent-deep: #C93F33;
    --color-gold: #D9A648;
    --color-cream: #3A3125;

    --color-on-accent: #FFFFFF;
    --color-num-strong: var(--color-accent-deep);

    /* 深色下阴影置 none 会与背景融为一体，改用发丝描边分离卡片层级 */
    --shadow-card: 0 0 0 1rpx rgba(255, 255, 255, 0.05);
    --shadow-float: 0 12rpx 48rpx rgba(0, 0, 0, 0.5);
    --shadow-accent: 0 8rpx 28rpx rgba(232, 86, 74, 0.30);

    --img-filter: brightness(0.9);
  }
}

/* ===== Manual Dark Mode Class ===== */
page.theme-dark {
  --color-primary: #E8564A;
  --color-primary-green: #3DB584;
  --color-primary-orange: #F59543;
  --color-primary-red: #FF5A4E;
  --color-primary-purple: #B478C7;
  --color-primary-pink: #F06292;

  --color-text-primary: #F5EFE8;
  --color-text-secondary: #A89C8E;
  --color-text-tertiary: #8C8074;

  --color-bg: #17130F;
  --color-bg-secondary: #201B16;
  --color-bg-tertiary: #2C261F;

  --color-card: #2A241D;
  --color-card-inner: #352E25;
  --color-border: #3E362C;
  --color-separator: rgba(200, 180, 150, 0.14);

  --color-accent: #E8564A;
  --color-accent-soft: rgba(232, 86, 74, 0.16);
  --color-accent-deep: #C93F33;
  --color-gold: #D9A648;
  --color-cream: #3A3125;

  --color-on-accent: #FFFFFF;
  --color-num-strong: var(--color-accent-deep);

  --shadow-card: 0 0 0 1rpx rgba(255, 255, 255, 0.05);
  --shadow-float: 0 12rpx 48rpx rgba(0, 0, 0, 0.5);
  --shadow-accent: 0 8rpx 28rpx rgba(232, 86, 74, 0.30);

  --img-filter: brightness(0.9);
}

/* ===== Manual Light Mode Class =====
   系统深色 + 手动选「浅色」时，page.theme-light 的特异度高于
   @media 内的 page，可正确覆盖回浅色令牌（否则浅色选项失效） */
page.theme-light {
  --color-primary: #D93A2B;
  --color-primary-green: #2F9E6E;
  --color-primary-orange: #F0821E;
  --color-primary-red: #E02020;
  --color-primary-purple: #9B59B6;
  --color-primary-pink: #E8467C;

  --color-text-primary: #2B2118;
  --color-text-secondary: #6F6459;
  --color-text-tertiary: #A69A8B;

  --color-bg: #FFFDF9;
  --color-bg-secondary: #FAF6F0;
  --color-bg-tertiary: #F1E9DE;

  --color-card: #FFFFFF;
  --color-card-inner: #FAF3EA;
  --color-border: #EDE3D5;
  --color-separator: rgba(139, 110, 78, 0.14);

  --color-accent: #D93A2B;
  --color-accent-soft: rgba(217, 58, 43, 0.10);
  --color-accent-deep: #B42A1D;
  --color-gold: #E6A23C;
  --color-cream: #FDF3E3;

  --color-on-accent: #FFFFFF;
  --color-num-strong: var(--color-accent-deep);

  --shadow-card: 0 4rpx 16rpx rgba(160, 110, 60, 0.08);
  --shadow-float: 0 12rpx 48rpx rgba(160, 110, 60, 0.18);
  --shadow-accent: 0 8rpx 28rpx rgba(217, 58, 43, 0.32);

  --img-filter: none;
}

/* ===== Accent Colors ===== */
page.accent-red { --color-accent: #D93A2B; --color-accent-deep: #B42A1D; }
page.accent-orange { --color-accent: #F0821E; --color-accent-deep: #D06A0F; }
/* 金色低对比兜底：金底上的文字用深棕，大数字用深金；深色下改用亮金（G5） */
page.accent-gold {
  --color-accent: #E6A23C;
  --color-accent-deep: #B8790F;
  --color-on-accent: #403000;
  --color-num-strong: #8A5B0B;
}
page.accent-green { --color-accent: #2F9E6E; --color-accent-deep: #21805A; }
/* 兼容旧缓存数据 */
page.accent-blue { --color-accent: #D93A2B; --color-accent-deep: #B42A1D; }
page.accent-pink { --color-accent: #E8467C; --color-accent-deep: #C72F63; }

@media (prefers-color-scheme: dark) {
  page.accent-gold {
    --color-accent-deep: #D9A648;
    --color-num-strong: #E6B856;
  }
}

page.theme-dark.accent-gold {
  --color-accent-deep: #D9A648;
  --color-num-strong: #E6B856;
}

/* ===== Global Utility Classes ===== */
.container {
  padding: 0 var(--spacing-lg);
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-card);
}

.card-white {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
}

/* Buttons */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--radius-pill);
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  padding: 0 var(--spacing-xl);
  transition: all 0.2s ease;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  color: var(--color-on-accent);
  box-shadow: var(--shadow-accent);
}

.btn-primary:active {
  opacity: 0.88;
  transform: scale(0.98);
}

.btn-secondary {
  background: var(--color-card);
  color: var(--color-accent-deep);
  border: 3rpx solid var(--color-accent);
  box-shadow: var(--shadow-card);
}

.btn-secondary:active {
  opacity: 0.7;
}

.btn-ghost {
  background: transparent;
  color: var(--color-accent);
}

.btn-danger {
  background: var(--color-primary-red);
  color: #FFFFFF;
}

.btn-block {
  width: 100%;
}

.btn-disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* Typography */
.title-lg {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--color-text-primary);
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.title-md {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-text-primary);
}

.title-sm {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.body-text {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
}

.caption {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.tertiary-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* Input */
.input {
  width: 100%;
  height: 96rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 0 var(--spacing-lg);
  font-size: 30rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
  box-shadow: var(--shadow-card);
}

.input-placeholder {
  color: var(--color-text-tertiary);
}

/* Divider */
.divider {
  height: 1rpx;
  background: var(--color-separator);
  margin: var(--spacing-md) 0;
}

/* Safe area */
.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

/* Flex utilities */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.flex-1 { flex: 1; }
.gap-sm { gap: var(--spacing-sm); }
.gap-md { gap: var(--spacing-md); }
.gap-lg { gap: var(--spacing-lg); }

/* Badge */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 500;
}

.badge-chef {
  background: rgba(240, 130, 30, 0.14);
  color: var(--color-primary-orange);
}

.badge-eater {
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

/* Loading */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) 0;
}

/* Animation */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.3s ease;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.pulse {
  animation: pulse 0.3s ease;
}

/* ===== 深色模式：菜品/头像图片压暗走令牌，手动浅色时可正确还原 ===== */
.dish-thumb-img,
.voter-avatar-img,
.profile-avatar-img {
  filter: var(--img-filter);
}

/* ===== 悬浮添加按钮（全局统一，自动避让 tabBar 与底部安全区） ===== */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 140rpx);
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-accent);
  z-index: 100;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.fab:active {
  transform: scale(0.92);
  opacity: 0.9;
}

.fab-icon {
  font-size: 56rpx;
  color: var(--color-on-accent);
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

/* app.wxss - 筷点吃饭 · 设计系统 v2
 * 暖调餐饮设计语言：辣椒红 + 米白 + 暖黑
 *
 * 令牌分四层：
 *   1) 主题家族色（warm / fresh / dark）—— 决定「情绪」，三家族表面色差异显著
 *   2) 语义色（text / surface / border）—— 页面只消费语义色，不直接写死颜色
 *   3) 尺度（space / radius / font / elev）—— 8pt 栅格，全局统一
 *   4) 语义类（.card / .btn / .section …）—— 组合令牌，保证跨页一致
 *
 * 使用约定：
 *   - 主题 class 挂在页面根 view（.theme-xxx），CSS 选择器写 .theme-xxx，不能写 page.theme-xxx
 *   - 新增颜色必须先定义语义令牌，禁止在页面 wxss 里直接写十六进制
 */

/* ============================================================
 * 1. 默认令牌（温馨暖调 = 冷启动首帧 / 无主题 class 时的兜底）
 * ============================================================ */
page {
  /* ---- 品牌多色板（分类、标签、图表专用，不随主题家族改变语义） ---- */
  --color-primary: #D93A2B;
  --color-primary-green: #2F9E6E;
  --color-primary-orange: #F0821E;
  --color-primary-red: #E02020;
  --color-primary-purple: #9B59B6;
  --color-primary-pink: #E8467C;

  /* ---- 文本层级（4 级，逐级降低关注度） ---- */
  --color-text-primary: #241B12;    /* 标题、菜品名 */
  --color-text-secondary: #6B5F52;  /* 正文、说明 */
  --color-text-tertiary: #A2968A;   /* 辅助信息、占位 */
  --color-text-inverse: #FFFFFF;    /* 压在深色/强调色上的文本 */

  /* ---- 表面层级（关键：与页面底色拉开明度差，卡片才「浮」得起来） ---- */
  --surface-page: #F3E9DA;          /* 页面底：暖米，比卡片深一档 */
  --surface-card: #FFFFFF;          /* 卡片：纯白 */
  --surface-sunken: #FBF5EC;        /* 凹陷块：卡内分区、输入框底 */
  --surface-raised: #FFFFFF;        /* 浮层：弹窗、菜单 */

  /* ---- 描边与分隔 ---- */
  --color-border: #EADCC6;          /* 常规描边 */
  --color-border-strong: #DCC9AC;   /* 强调描边（选中、输入框聚焦） */
  --hairline: rgba(139, 110, 78, 0.14);  /* 发丝分隔线 */

  /* ---- 强调色（主题家族的「签名色」） ---- */
  --color-accent: #D93A2B;
  --color-accent-hover: #C22E20;
  --color-accent-deep: #A32318;
  --color-accent-soft: rgba(217, 58, 43, 0.10);   /* 淡底标签 */
  --color-accent-wash: rgba(217, 58, 43, 0.06);   /* 大面积淡染 */
  --color-on-accent: #FFFFFF;       /* 压在强调色上的文字/图标 */
  --color-num-strong: #A32318;      /* 大数字：比 accent 深一档，保证浅色系下可读 */

  /* ---- 主题签名装饰（hero 渐变、光斑） ---- */
  --tint-1: rgba(217, 58, 43, 0.10);
  --tint-2: rgba(230, 162, 60, 0.12);
  --tint-3: rgba(217, 58, 43, 0);

  /* ---- 功能色 ---- */
  --color-success: #2F9E6E;
  --color-warning: #E6A23C;
  --color-danger: #E02020;
  --color-gold: #E6A23C;
  --color-cream: #FDEBD2;           /* 米黄信息块（米饭卡、统计栏） */

  /* ---- 图片滤镜（深色模式压暗，手动浅色可还原） ---- */
  --img-filter: none;

  /* ============================================================
   * 3a. 间距：8pt 栅格（1pt = 2rpx @750rpx 设计稿）
   * ============================================================ */
  --space-1: 8rpx;    /* 4pt  */
  --space-2: 16rpx;   /* 8pt  */
  --space-3: 24rpx;   /* 12pt */
  --space-4: 32rpx;   /* 16pt —— 页边距基准 */
  --space-5: 40rpx;   /* 20pt */
  --space-6: 48rpx;   /* 24pt —— 卡片内边距 / 区块间距 */
  --space-8: 64rpx;   /* 32pt */
  --space-10: 80rpx;  /* 40pt */
  --space-12: 96rpx;  /* 48pt */

  /* 旧别名：保证存量页面不破坏 */
  --spacing-xs: var(--space-1);
  --spacing-sm: var(--space-2);
  --spacing-md: var(--space-3);
  --spacing-lg: var(--space-4);
  --spacing-xl: var(--space-6);

  /* ============================================================
   * 3b. 圆角：层级化，大容器更圆、小元素更收敛
   * ============================================================ */
  --radius-xs: 12rpx;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 44rpx;
  --radius-pill: 999rpx;

  /* ============================================================
   * 3c. 字阶：5 档 + 行高，杜绝「随手定字号」
   * ============================================================ */
  --font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;

  --text-display: 64rpx;   /* 欢迎页大标题 */
  --text-h1: 52rpx;        /* 页面主标题 */
  --text-h2: 40rpx;        /* 区块标题 */
  --text-h3: 34rpx;        /* 卡片标题 / 大数字 */
  --text-body: 30rpx;      /* 正文 */
  --text-body-sm: 28rpx;   /* 次要正文 / 按钮 */
  --text-caption: 24rpx;   /* 辅助说明 */
  --text-mini: 22rpx;      /* 角标 / 时间戳 */

  --lh-tight: 1.2;   /* 标题 */
  --lh-normal: 1.5;  /* 正文 */
  --lh-loose: 1.6;   /* 多行说明 */

  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;
  --weight-black: 800;

  /* ============================================================
   * 3d. 阴影层级：明度差 + 投影双重表达；深色模式降级为发丝描边
   * ============================================================ */
  --elev-1: 0 2rpx 8rpx rgba(140, 95, 45, 0.06), 0 8rpx 24rpx rgba(140, 95, 45, 0.06);
  --elev-2: 0 4rpx 12rpx rgba(140, 95, 45, 0.08), 0 16rpx 40rpx rgba(140, 95, 45, 0.10);
  --elev-3: 0 12rpx 48rpx rgba(140, 95, 45, 0.18);
  --elev-accent: 0 6rpx 20rpx rgba(217, 58, 43, 0.30);

  /* 旧别名 */
  --shadow-card: var(--elev-1);
  --shadow-float: var(--elev-3);
  --shadow-accent: var(--elev-accent);

  /* ============================================================
   * 3e. 动效与按压
   * ============================================================ */
  --press-scale: 0.97;
  --press-opacity: 0.7;
  --dur-fast: 0.15s;
  --dur-base: 0.25s;
  --ease-out: cubic-bezier(0.22, 0.61, 0.36, 1);

  /* 旧令牌别名：存量页面过渡期继续可用；新代码一律用语义令牌 */
  --color-bg: var(--surface-card);
  --color-bg-secondary: var(--surface-page);
  --color-bg-tertiary: var(--surface-sunken);
  --color-card: var(--surface-card);
  --color-card-inner: var(--surface-sunken);
  --color-separator: var(--hairline);

  background-color: #F3E9DA;
  color: var(--color-text-primary);
  font-family: var(--font-family);
  font-size: var(--text-body-sm);
  line-height: var(--lh-normal);
  -webkit-font-smoothing: antialiased;
}

/* ============================================================
 * 1a. 系统深色兜底（冷启动首帧，onShow 前）
 *     运行时由 theme.js 挂 .theme-dark 接管，两块内容必须保持一致
 * ============================================================ */
@media (prefers-color-scheme: dark) {
  page {
    --color-text-primary: #F7F1E9;
    --color-text-secondary: #ADA093;
    --color-text-tertiary: #8A7D70;
    --color-text-inverse: #1A1510;

    --surface-page: #14100C;
    --surface-card: #221C16;
    --surface-sunken: #1A1510;
    --surface-raised: #2C251D;

    --color-border: #362E25;
    --color-border-strong: #4A4034;
    --hairline: rgba(220, 200, 175, 0.12);

    --color-accent: #FF6B5A;
    --color-accent-hover: #FF8071;
    --color-accent-deep: #E8503E;
    --color-accent-soft: rgba(255, 107, 90, 0.16);
    --color-accent-wash: rgba(255, 107, 90, 0.08);
    --color-on-accent: #1A1510;
    --color-num-strong: #FF8B7C;

    --tint-1: rgba(255, 107, 90, 0.14);
    --tint-2: rgba(217, 166, 72, 0.10);
    --tint-3: rgba(255, 107, 90, 0);

    --color-success: #3DB584;
    --color-warning: #D9A648;
    --color-danger: #FF5A4E;
    --color-gold: #D9A648;
    --color-cream: #2E2418;

    --img-filter: brightness(0.88);

    --color-bg: var(--surface-card);
    --color-bg-secondary: var(--surface-page);
    --color-bg-tertiary: var(--surface-sunken);
    --color-card: var(--surface-card);
    --color-card-inner: var(--surface-sunken);
    --color-separator: var(--hairline);

    /* 深色下投影会被背景吞掉，改用「发丝描边 + 微弱投影」分离层级 */
    --elev-1: 0 0 0 1rpx rgba(255, 240, 220, 0.06);
    --elev-2: 0 0 0 1rpx rgba(255, 240, 220, 0.08), 0 8rpx 24rpx rgba(0, 0, 0, 0.32);
    --elev-3: 0 0 0 1rpx rgba(255, 240, 220, 0.10), 0 16rpx 48rpx rgba(0, 0, 0, 0.55);
    --elev-accent: 0 6rpx 20rpx rgba(255, 107, 90, 0.26);

    --shadow-card: var(--elev-1);
    --shadow-float: var(--elev-3);
    --shadow-accent: var(--elev-accent);
  }
}

/* ============================================================
 * 主题家族 A：静谧夜间（暖黑）
 * ============================================================ */
.theme-dark {
  --color-text-primary: #F7F1E9;
  --color-text-secondary: #ADA093;
  --color-text-tertiary: #8A7D70;
  --color-text-inverse: #1A1510;

  --surface-page: #14100C;
  --surface-card: #221C16;
  --surface-sunken: #1A1510;
  --surface-raised: #2C251D;

  --color-border: #362E25;
  --color-border-strong: #4A4034;
  --hairline: rgba(220, 200, 175, 0.12);

  --color-accent: #FF6B5A;
  --color-accent-hover: #FF8071;
  --color-accent-deep: #E8503E;
  --color-accent-soft: rgba(255, 107, 90, 0.16);
  --color-accent-wash: rgba(255, 107, 90, 0.08);
  --color-on-accent: #1A1510;
  --color-num-strong: #FF8B7C;

  --tint-1: rgba(255, 107, 90, 0.14);
  --tint-2: rgba(217, 166, 72, 0.10);
  --tint-3: rgba(255, 107, 90, 0);

  --color-success: #3DB584;
  --color-warning: #D9A648;
  --color-danger: #FF5A4E;
  --color-gold: #D9A648;
  --color-cream: #2E2418;

  --img-filter: brightness(0.88);

  --color-bg: var(--surface-card);
  --color-bg-secondary: var(--surface-page);
  --color-bg-tertiary: var(--surface-sunken);
  --color-card: var(--surface-card);
  --color-card-inner: var(--surface-sunken);
  --color-separator: var(--hairline);

  --elev-1: 0 0 0 1rpx rgba(255, 240, 220, 0.06);
  --elev-2: 0 0 0 1rpx rgba(255, 240, 220, 0.08), 0 8rpx 24rpx rgba(0, 0, 0, 0.32);
  --elev-3: 0 0 0 1rpx rgba(255, 240, 220, 0.10), 0 16rpx 48rpx rgba(0, 0, 0, 0.55);
  --elev-accent: 0 6rpx 20rpx rgba(255, 107, 90, 0.26);

  --shadow-card: var(--elev-1);
  --shadow-float: var(--elev-3);
  --shadow-accent: var(--elev-accent);
}

/* ============================================================
 * 主题家族 B：温馨暖调（辣椒红 + 米白）
 * 页面底刻意压深到 #F3E9DA，让纯白卡片有明确「浮起」感
 * ============================================================ */
.theme-warm {
  --color-text-primary: #241B12;
  --color-text-secondary: #6B5F52;
  --color-text-tertiary: #A2968A;
  --color-text-inverse: #FFFFFF;

  --surface-page: #F3E9DA;
  --surface-card: #FFFFFF;
  --surface-sunken: #FBF5EC;
  --surface-raised: #FFFFFF;

  --color-border: #EADCC6;
  --color-border-strong: #DCC9AC;
  --hairline: rgba(139, 110, 78, 0.14);

  --color-accent: #D93A2B;
  --color-accent-hover: #C22E20;
  --color-accent-deep: #A32318;
  --color-accent-soft: rgba(217, 58, 43, 0.10);
  --color-accent-wash: rgba(217, 58, 43, 0.06);
  --color-on-accent: #FFFFFF;
  --color-num-strong: #A32318;

  --tint-1: rgba(217, 58, 43, 0.10);
  --tint-2: rgba(230, 162, 60, 0.12);
  --tint-3: rgba(217, 58, 43, 0);

  --color-success: #2F9E6E;
  --color-warning: #E6A23C;
  --color-danger: #E02020;
  --color-gold: #E6A23C;
  --color-cream: #FDEBD2;

  --img-filter: none;

  --color-bg: var(--surface-card);
  --color-bg-secondary: var(--surface-page);
  --color-bg-tertiary: var(--surface-sunken);
  --color-card: var(--surface-card);
  --color-card-inner: var(--surface-sunken);
  --color-separator: var(--hairline);

  --elev-1: 0 2rpx 8rpx rgba(140, 95, 45, 0.06), 0 8rpx 24rpx rgba(140, 95, 45, 0.06);
  --elev-2: 0 4rpx 12rpx rgba(140, 95, 45, 0.08), 0 16rpx 40rpx rgba(140, 95, 45, 0.10);
  --elev-3: 0 12rpx 48rpx rgba(140, 95, 45, 0.18);
  --elev-accent: 0 6rpx 20rpx rgba(217, 58, 43, 0.30);

  --shadow-card: var(--elev-1);
  --shadow-float: var(--elev-3);
  --shadow-accent: var(--elev-accent);
}

/* ============================================================
 * 主题家族 C：清新绿意（葱青绿 + 薄荷白）
 * 与暖调的差异不只换强调色：页面底换成明显偏冷的薄荷绿、
 * 卡内分区换成淡绿、投影带绿相 —— 一眼可辨
 * ============================================================ */
.theme-fresh {
  --color-text-primary: #17251B;
  --color-text-secondary: #556B5C;
  --color-text-tertiary: #8AA392;

  --surface-page: #DDEBE0;     /* 明显偏冷偏绿，与暖米底拉开 */
  --surface-card: #FBFEFC;     /* 带一丝冷白的卡片 */
  --surface-sunken: #E9F5EB;   /* 卡内分区：薄荷 */
  --surface-raised: #FFFFFF;

  --color-border: #C9E0CF;
  --color-border-strong: #A8CCB4;
  --hairline: rgba(47, 110, 70, 0.14);

  --color-accent: #1F9360;
  --color-accent-hover: #188050;
  --color-accent-deep: #12653E;
  --color-accent-soft: rgba(31, 147, 96, 0.12);
  --color-accent-wash: rgba(31, 147, 96, 0.07);
  --color-on-accent: #FFFFFF;
  --color-num-strong: #12653E;

  --tint-1: rgba(31, 147, 96, 0.12);
  --tint-2: rgba(120, 190, 150, 0.16);
  --tint-3: rgba(31, 147, 96, 0);

  --color-success: #1F9360;
  --color-warning: #D99B33;
  --color-danger: #D94A3D;
  --color-gold: #D99B33;
  --color-cream: #E2F3E7;      /* 薄荷信息块 */

  --img-filter: none;

  --color-bg: var(--surface-card);
  --color-bg-secondary: var(--surface-page);
  --color-bg-tertiary: var(--surface-sunken);
  --color-card: var(--surface-card);
  --color-card-inner: var(--surface-sunken);
  --color-separator: var(--hairline);

  --elev-1: 0 2rpx 8rpx rgba(30, 105, 65, 0.06), 0 8rpx 24rpx rgba(30, 105, 65, 0.08);
  --elev-2: 0 4rpx 12rpx rgba(30, 105, 65, 0.08), 0 16rpx 40rpx rgba(30, 105, 65, 0.12);
  --elev-3: 0 12rpx 48rpx rgba(30, 105, 65, 0.20);
  --elev-accent: 0 6rpx 20rpx rgba(31, 147, 96, 0.28);

  --shadow-card: var(--elev-1);
  --shadow-float: var(--elev-3);
  --shadow-accent: var(--elev-accent);
}

/* ============================================================
 * 主题家族 D：晴空浅蓝（晴空蓝 + 云白）
 * 底色偏冷蓝，投影带蓝相，与暖米/薄荷绿形成第三种可辨情绪
 * ============================================================ */
.theme-sky {
  --color-text-primary: #14212B;
  --color-text-secondary: #52646F;
  --color-text-tertiary: #8FA1AC;

  --surface-page: #DCEAF6;     /* 云蓝底 */
  --surface-card: #FBFDFF;     /* 冷白云卡 */
  --surface-sunken: #E8F2FA;
  --surface-raised: #FFFFFF;

  --color-border: #C6DAEA;
  --color-border-strong: #A3C2D9;
  --hairline: rgba(47, 110, 150, 0.14);

  --color-accent: #2E8FD8;
  --color-accent-hover: #2579BD;
  --color-accent-deep: #1C5F94;
  --color-accent-soft: rgba(46, 143, 216, 0.12);
  --color-accent-wash: rgba(46, 143, 216, 0.07);
  --color-on-accent: #FFFFFF;
  --color-num-strong: #1C5F94;

  --tint-1: rgba(46, 143, 216, 0.12);
  --tint-2: rgba(120, 170, 220, 0.16);
  --tint-3: rgba(46, 143, 216, 0);

  --color-success: #2F9E6E;
  --color-warning: #D99B33;
  --color-danger: #D94A3D;
  --color-gold: #D99B33;
  --color-cream: #E0EFF8;      /* 淡蓝信息块 */

  --img-filter: none;

  --color-bg: var(--surface-card);
  --color-bg-secondary: var(--surface-page);
  --color-bg-tertiary: var(--surface-sunken);
  --color-card: var(--surface-card);
  --color-card-inner: var(--surface-sunken);
  --color-separator: var(--hairline);

  --elev-1: 0 2rpx 8rpx rgba(30, 90, 140, 0.06), 0 8rpx 24rpx rgba(30, 90, 140, 0.08);
  --elev-2: 0 4rpx 12rpx rgba(30, 90, 140, 0.08), 0 16rpx 40rpx rgba(30, 90, 140, 0.12);
  --elev-3: 0 12rpx 48rpx rgba(30, 90, 140, 0.20);
  --elev-accent: 0 6rpx 20rpx rgba(46, 143, 216, 0.28);

  --shadow-card: var(--elev-1);
  --shadow-float: var(--elev-3);
  --shadow-accent: var(--elev-accent);
}


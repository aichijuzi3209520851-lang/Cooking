}

/* ============================================================
 * 主题载体：根 view 承载页面底色，保证三家族切换时整屏变色
 * （theme.js 同时会调用 wx.setBackgroundColor 兜住窗口层）
 * ============================================================ */
.theme-warm,
.theme-fresh,
.theme-sky,
.theme-pink,
.theme-dark {
  background-color: var(--surface-page);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============================================================
 * 4. 全局语义类
 * ============================================================ */

/* ---- 页面容器：统一页边距与底部安全区 ---- */
.container {
  padding: 0 var(--space-4);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---- 区块：垂直节奏统一 ---- */
.section {
  margin-bottom: var(--space-6);
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: var(--text-h3);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
  margin-bottom: var(--space-1);
}

.section-sub {
  font-size: var(--text-caption);
  color: var(--color-text-tertiary);
  line-height: var(--lh-normal);
  margin-bottom: var(--space-3);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-3);
}

/* ---- 卡片 ---- */
.card {
  background: var(--surface-card);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
  box-shadow: var(--elev-1);
  box-sizing: border-box;
}

.card-flat {
  background: var(--surface-card);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
  border: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.card-sunken {
  background: var(--surface-sunken);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  box-sizing: border-box;
}

/* 卡片按压（可点击整卡时使用） */
.card-tappable {
  transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
}

.card-tappable:active {
  transform: scale(0.985);
  opacity: 0.92;
}

/* ---- 分隔线 ---- */
.divider {
  height: 1rpx;
  background: var(--hairline);
  margin: var(--space-3) 0;
}

/* ============================================================
 * 按钮体系：三档高度 × 三种强调
 * ============================================================ */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--radius-pill);
  font-size: var(--text-body);
  font-weight: var(--weight-semibold);
  border: none;
  padding: 0 var(--space-6);
  box-sizing: border-box;
  transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
}

.btn::after {
  border: none;
}

/* 中号按钮（表单、卡片内） */
.btn-md {
  height: 84rpx;
  font-size: var(--text-body-sm);
  padding: 0 var(--space-5);
}

/* 小号按钮（列表项右侧） */
.btn-sm {
  height: 68rpx;
  font-size: var(--text-caption);
  font-weight: var(--weight-semibold);
  padding: 0 var(--space-4);
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  color: var(--color-on-accent);
  box-shadow: var(--elev-accent);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-secondary {
  background: var(--surface-card);
  color: var(--color-accent-deep);
  border: 2rpx solid var(--color-accent);
  box-shadow: var(--elev-1);
}

.btn-secondary:active {
  opacity: var(--press-opacity);
}

.btn-soft {
  background: var(--color-accent-soft);
  color: var(--color-accent-deep);
}

.btn-soft:active {
  opacity: var(--press-opacity);
}

.btn-ghost {
  background: transparent;
  color: var(--color-accent);
}

.btn-ghost:active {
  opacity: var(--press-opacity);
}

.btn-danger {
  background: var(--color-danger);
  color: #FFFFFF;
}

.btn-danger:active {
  opacity: 0.9;
}

.btn-block {
  width: 100%;
}

.btn-disabled,
.btn[disabled] {
  opacity: 0.4;
  pointer-events: none;
}

/* 按钮组：统一间距与对齐 */
.btn-group {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.btn-group > .btn,
.btn-group > view {
  flex: 1;
  min-width: 0;
}

/* ============================================================
 * 文字工具类
 * ============================================================ */
.title-lg {
  font-size: var(--text-display);
  font-weight: var(--weight-black);
  color: var(--color-text-primary);
  letter-spacing: -1rpx;
  line-height: var(--lh-tight);
}

.title-md {
  font-size: var(--text-h2);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
}

.title-sm {
  font-size: var(--text-body);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
}

.body-text {
  font-size: var(--text-body);
  color: var(--color-text-primary);
  line-height: var(--lh-loose);
}

.caption {
  font-size: var(--text-caption);
  color: var(--color-text-secondary);
  line-height: var(--lh-normal);
}

.text-tertiary { color: var(--color-text-tertiary); }
.text-secondary { color: var(--color-text-secondary); }
.text-accent { color: var(--color-accent); }
.text-danger { color: var(--color-danger); }
.text-success { color: var(--color-success); }

.text-medium { font-weight: var(--weight-medium); }
.text-semibold { font-weight: var(--weight-semibold); }
.text-bold { font-weight: var(--weight-bold); }

.text-center { text-align: center; }
.text-right { text-align: right; }

/* 单行截断 / 两行截断 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ============================================================
 * 表单
 * ============================================================ */
.field {
  margin-bottom: var(--space-4);
}

.field-label {
  display: block;
  font-size: var(--text-caption);
  font-weight: var(--weight-semibold);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-2);
}

.input {
  width: 100%;
  height: 96rpx;
  background: var(--surface-sunken);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0 var(--space-4);
  font-size: var(--text-body);
  color: var(--color-text-primary);
  box-sizing: border-box;
  transition: border-color var(--dur-fast) var(--ease-out);
}

.input-placeholder {
  color: var(--color-text-tertiary);
}

/* ============================================================
 * 徽章
 * ============================================================ */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  font-size: var(--text-mini);
  font-weight: var(--weight-medium);
  line-height: 1.4;
}

/* 掌勺的：品牌强调色（家庭里的活跃角色） */
.badge-chef {
  background: var(--color-accent-soft);
  color: var(--color-accent-deep);
}

/* 等饭的：中性安静样式，与掌勺形成层级 */
.badge-eater {
  background: var(--surface-sunken);
  color: var(--color-text-secondary);
}

/* ============================================================
 * 布局工具：栅格 + 堆叠
 * ============================================================ */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }
.items-baseline { align-items: baseline; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-end { justify-content: flex-end; }
.flex-1 { flex: 1; min-width: 0; }

.gap-xs { gap: var(--space-1); }
.gap-sm { gap: var(--space-2); }
.gap-md { gap: var(--space-3); }
.gap-lg { gap: var(--space-4); }

/* 等宽两列 / 三列栅格 */
.grid { display: flex; flex-wrap: wrap; gap: var(--space-3); }
.grid-2 > view, .grid-2 > .grid-item { width: calc((100% - var(--space-3)) / 2); }
.grid-3 > view, .grid-3 > .grid-item { width: calc((100% - var(--space-3) * 2) / 3); }

/* 垂直堆叠（替代逐个元素写 margin-bottom） */
.stack { display: flex; flex-direction: column; }
.stack-sm { gap: var(--space-2); }
.stack-md { gap: var(--space-3); }
.stack-lg { gap: var(--space-4); }

/* ============================================================
 * 其它
 * ============================================================ */
.press {
  transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
}

.press:active {
  opacity: var(--press-opacity);
  transform: scale(0.98);
}

.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 140rpx);
}

.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-10) 0;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn var(--dur-base) var(--ease-out);
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.pulse {
  animation: pulse 0.3s ease;
}

/* ===== 深色模式：菜品/头像图片压暗走令牌，手动浅色时可正确还原 ===== */
.dish-thumb-img,
.voter-avatar-img,
.profile-avatar-img {
  filter: var(--img-filter);
}

/* ===== 悬浮添加按钮（全局统一，自动避让 tabBar 与底部安全区） ===== */
.fab {
  position: fixed;
  right: var(--space-4);
  bottom: calc(env(safe-area-inset-bottom) + 140rpx);
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--elev-accent);
  z-index: 100;
  transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
}

.fab:active {
  transform: scale(0.92);
  opacity: 0.9;
}

.fab-icon {
  font-size: 56rpx;
  color: var(--color-on-accent);
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

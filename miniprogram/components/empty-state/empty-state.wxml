<!-- components/empty-state/empty-state.wxml -->
<view class="empty-state">
  <view class="empty-illust">
    <image
      wx:if="{{image && !imageFailed}}"
      class="empty-image"
      src="{{image}}"
      mode="aspectFit"
      binderror="onImageError"
    />
    <view wx:else class="empty-icon">{{icon}}</view>
  </view>
  <view class="empty-title">{{title}}</view>
  <view wx:if="{{description}}" class="empty-desc">{{description}}</view>
</view>

/* components/empty-state/empty-state.wxss */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  box-sizing: border-box;
}

.empty-icon {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.empty-image {
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  text-align: center;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin-top: 8rpx;
  text-align: center;
  padding: 0 48rpx;
}

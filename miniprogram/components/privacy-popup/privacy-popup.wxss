/* components/privacy-popup/privacy-popup.wxss */
/* 遮罩/层级走 app.wxss 弹层基类 .overlay-mask；此处只留弹窗自身布局 */

.pp-mask {
  padding: var(--space-4, 32rpx);
  box-sizing: border-box;
}

.pp-dialog {
  width: 100%;
  max-width: 600rpx;
  background: var(--surface-raised, #ffffff);
  border-radius: var(--radius-lg, 32rpx);
  padding: var(--space-6, 48rpx) var(--space-5, 40rpx) var(--space-5, 40rpx);
  box-sizing: border-box;
  box-shadow: var(--elev-3);
}

.pp-title {
  font-size: var(--text-h3);
  font-weight: 600;
  color: var(--color-text-primary, #241b12);
  text-align: center;
  margin-bottom: var(--space-4, 32rpx);
}

.pp-body {
  margin-bottom: var(--space-6, 48rpx);
}

.pp-p {
  font-size: var(--text-body-sm);
  line-height: 1.7;
  color: var(--color-text-secondary, #6b5f52);
}

.pp-center {
  text-align: center;
  margin: var(--space-2, 16rpx) 0;
}

.pp-link {
  color: var(--color-accent, #d93a2b);
  font-weight: var(--weight-medium, 500);
}

.pp-tip {
  margin-top: var(--space-3, 24rpx);
  font-size: var(--text-caption);
  color: var(--color-text-tertiary, #a2968a);
  background: var(--surface-sunken, #fbf5ec);
  border-radius: var(--radius-sm, 16rpx);
  padding: var(--space-3, 24rpx);
}

.pp-actions {
  display: flex;
  align-items: center;
  gap: var(--space-3, 24rpx);
}

.pp-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: var(--radius-pill);
  font-size: var(--text-body);
  font-weight: var(--weight-semibold, 600);
  box-sizing: border-box;
}

.pp-btn-ghost {
  color: var(--color-text-secondary, #6b5f52);
  background: var(--surface-sunken, #fbf5ec);
}

.pp-btn-primary {
  color: var(--color-on-accent, #ffffff);
  background: linear-gradient(135deg, var(--color-accent, #d93a2b), var(--color-accent-deep, #a32318));
  border: none;
  padding: 0;
}

/* 去掉小程序 button 默认边框与圆角覆盖 */
.pp-btn-primary::after {
  border: none;
}

/* components/dish-card/dish-card.wxss
 * 三栏栅格：缩略图 128rpx（固定） + 信息区（自适应，min-width:0 防溢出） + 操作区（固定）
 * 内边距 32rpx，卡片间距 24rpx，与 menu 页骨架屏尺寸严格对齐，避免加载完成时跳动
 */
.dish-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--surface-card);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-4);
  box-shadow: var(--elev-1);
  box-sizing: border-box;
  transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
}

.dish-card:active {
  box-shadow: var(--elev-2);
}

/* 左侧缩略图 */
.dish-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  margin-right: var(--space-3);
  background: var(--surface-sunken);
}

/* 可预览的缩略图按压反馈 */
.dish-thumb-tappable:active {
  opacity: 0.85;
  transform: scale(0.96);
}

.dish-thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.dish-thumb-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-cream);
  border-radius: var(--radius-md);
}

.dish-thumb-cat {
  width: 72%;
  height: 72%;
}

.dish-thumb-emoji {
  font-size: 56rpx;
  line-height: 1;
}

/* 中间信息 */
.dish-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-right: var(--space-2);
}

.dish-name {
  font-size: var(--text-h3);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
  margin-bottom: var(--space-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-voters {
  display: flex;
  align-items: center;
  min-height: 40rpx;
}

/* 推荐理由：与推荐区季节文案同色同字重，形成「推荐语境」的视觉一致性 */
.dish-reason {
  font-size: var(--text-body-sm);
  font-weight: var(--weight-medium);
  color: var(--color-accent-deep);
  line-height: var(--lh-normal);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dish-voters-empty {
  font-size: var(--text-body-sm);
  color: var(--color-text-tertiary);
  line-height: var(--lh-normal);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 右侧按钮 */
.dish-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.btn-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 var(--space-4);
  border-radius: var(--radius-pill);
  font-size: var(--text-body-sm);
  font-weight: var(--weight-semibold);
  line-height: 1;
  box-sizing: border-box;
  position: relative;
  white-space: nowrap;
  transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
}

/* 视觉 72rpx，热区外扩至 ≥88rpx（44px）触控底线 */
.btn-pill::after {
  content: '';
  position: absolute;
  top: -10rpx;
  left: -12rpx;
  right: -12rpx;
  bottom: -10rpx;
}

.btn-pill:active {
  opacity: 0.7;
  transform: scale(0.96);
}

.btn-pill-filled {
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  color: var(--color-on-accent);
  box-shadow: var(--elev-accent);
  /* 投票成功弹跳：类名从 outline 切换到 filled 时新节点挂载，动画自然播放 */
  animation: vote-pop 0.3s ease;
}

@keyframes vote-pop {
  0% { transform: scale(0.85); }
  60% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

.btn-pill-outline {
  background: transparent;
  color: var(--color-accent);
  border: 2rpx solid var(--color-accent);
}

/* components/dish-card/dish-card.wxss */
.dish-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

/* 左侧缩略图 */
.dish-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 22rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 24rpx;
}

/* 可预览的缩略图按压反馈 */
.dish-thumb-tappable:active {
  opacity: 0.85;
  transform: scale(0.96);
}

.dish-thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.dish-thumb-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-cream);
  border-radius: 22rpx;
}

.dish-thumb-cat {
  width: 72%;
  height: 72%;
}

.dish-thumb-emoji {
  font-size: 52rpx;
  line-height: 1;
}

/* 中间信息 */
.dish-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-right: 16rpx;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.3;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-voters {
  display: flex;
  align-items: center;
  min-height: 40rpx;
}

.dish-voters-empty {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

/* 右侧按钮 */
.dish-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.btn-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 36rpx;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  box-sizing: border-box;
  position: relative;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

/* 视觉 80rpx，热区外扩至 ≥88rpx（44px）触控底线 */
.btn-pill::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: -12rpx;
  right: -12rpx;
  bottom: -8rpx;
}

.btn-pill:active {
  opacity: 0.7;
  transform: scale(0.97);
}

.btn-pill-filled {
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  color: var(--color-on-accent);
  box-shadow: var(--shadow-accent);
  /* 投票成功弹跳：类名从 outline 切换到 filled 时新节点挂载，动画自然播放 */
  animation: vote-pop 0.3s ease;
}

@keyframes vote-pop {
  0% { transform: scale(0.85); }
  60% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

.btn-pill-outline {
  background: transparent;
  color: var(--color-accent);
  border: 2rpx solid var(--color-accent);
}

<!-- components/dish-card/dish-card.wxml -->
<view class="dish-card" bindlongpress="onLongPress">
  <!-- 左侧图片（有图可点开全屏预览） -->
  <view class="dish-thumb {{hasImage ? 'dish-thumb-tappable' : ''}}" bindtap="onPreviewImage">
    <image
      wx:if="{{hasImage}}"
      class="dish-thumb-img"
      src="{{dish.imageUrl}}"
      mode="aspectFill"
      binderror="onImageError"
    />
    <view wx:else class="dish-thumb-placeholder">
      <image
        wx:if="{{categoryImage}}"
        class="dish-thumb-cat"
        src="{{categoryImage}}"
        mode="aspectFit"
      />
      <text wx:else class="dish-thumb-emoji">{{emoji}}</text>
    </view>
  </view>

  <!-- 中间信息 -->
  <view class="dish-info">
    <view class="dish-name">{{dish.name}}</view>
    <view class="dish-voters">
      <!-- 推荐理由优先：说明「为什么推这道菜」，比空态文案有信息量 -->
      <text wx:if="{{reasonText}}" class="dish-reason">{{reasonText}}</text>
      <avatar-group
        wx:elif="{{voterList.length > 0}}"
        members="{{voterList}}"
        max="{{5}}"
        size="{{40}}"
      />
      <text wx:else class="dish-voters-empty">还没有人想吃</text>
    </view>
  </view>

  <!-- 右侧按钮 -->
  <view class="dish-action">
    <view
      wx:if="{{hasVoted}}"
      class="btn-pill btn-pill-filled"
      bindtap="onCancel"
    >
      已想吃
    </view>
    <view
      wx:else
      class="btn-pill btn-pill-outline"
      bindtap="onVote"
    >
      我想吃
    </view>
  </view>
</view>

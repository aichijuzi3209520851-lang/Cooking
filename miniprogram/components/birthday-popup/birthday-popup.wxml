<!--components/birthday-popup/birthday-popup.wxml-->
<!--生日当天公告弹窗（BIRTHDAY-003）：寿星与家人看到的是两套文案，
    由 utils/birthday.js#buildPopupContent 生成后从页面传进来。-->
<view wx:if="{{visible}}" class="bp-mask" catchtouchmove="onCatchMove">
  <view class="bp-dialog">

    <view class="bp-badge">
      <text class="bp-badge-emoji">🎂</text>
    </view>

    <view class="bp-title">{{title}}</view>
    <view class="bp-body">{{body}}</view>

    <view class="bp-blessing">
      <text class="bp-blessing-text">{{blessing}}</text>
    </view>

    <view class="bp-btn" bindtap="onClose" hover-class="bp-btn-press" aria-role="button">
      <text class="bp-btn-text">知道啦</text>
    </view>

  </view>
</view>

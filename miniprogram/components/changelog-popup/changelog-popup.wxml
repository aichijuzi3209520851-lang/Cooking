<!--components/changelog-popup/changelog-popup.wxml-->
<!--本版本未展示过更新说明时展示；关闭后写入本地标记，同版本不再弹。-->
<view wx:if="{{visible}}" class="cl-mask" catchtouchmove="onCatchMove">
  <view class="cl-dialog">

    <view class="cl-badge">新版本</view>
    <view class="cl-title">{{release.title}}</view>
    <view class="cl-meta">v{{release.version}} · {{release.date}}</view>

    <scroll-view scroll-y class="cl-body">
      <view class="cl-item" wx:for="{{release.items}}" wx:key="*this">
        <view class="cl-dot"></view>
        <text class="cl-item-text">{{item}}</text>
      </view>
    </scroll-view>

    <view class="cl-actions">
      <view class="cl-btn" hover-class="cl-btn-hover" bindtap="onClose">知道了</view>
    </view>

  </view>
</view>

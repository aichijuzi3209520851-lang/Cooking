/* components/changelog-popup/changelog-popup.wxss */
/* 遮罩/层级走 app.wxss 弹层基类 .overlay-mask；此处只留弹窗自身布局 */

.cl-mask {
  padding: var(--space-4, 32rpx);
  box-sizing: border-box;
}

.cl-dialog {
  width: 100%;
  max-width: 600rpx;
  max-height: 80vh;
  background: var(--surface-raised, #ffffff);
  border-radius: var(--radius-lg, 32rpx);
  padding: var(--space-6, 48rpx) var(--space-5, 40rpx) var(--space-5, 40rpx);
  box-sizing: border-box;
  box-shadow: var(--elev-3);
  display: flex;
  flex-direction: column;
  animation: cl-pop 200ms ease-out;
}

@keyframes cl-pop {
  from {
    transform: scale(0.94);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .cl-dialog {
    animation: none;
  }
}

.cl-badge {
  align-self: flex-start;
  font-size: var(--text-mini, 22rpx);
  font-weight: var(--weight-semibold, 600);
  color: var(--color-on-accent, #ffffff);
  background: var(--color-accent, #d93a2b);
  border-radius: var(--radius-pill);
  padding: 4rpx 20rpx;
  margin-bottom: var(--space-3, 24rpx);
}

.cl-title {
  font-size: var(--text-h3, 38rpx);
  font-weight: var(--weight-bold, 700);
  color: var(--color-text-primary, #241b12);
  line-height: 1.35;
}

.cl-meta {
  font-size: var(--text-caption, 24rpx);
  color: var(--color-text-tertiary, #a2968a);
  margin: var(--space-2, 16rpx) 0 var(--space-4, 32rpx);
}

.cl-body {
  max-height: 46vh;
  margin-bottom: var(--space-5, 40rpx);
}

.cl-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
}

.cl-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-accent, #d93a2b);
  margin-top: 16rpx;
}

.cl-item-text {
  font-size: var(--text-body-sm, 26rpx);
  line-height: 1.7;
  color: var(--color-text-secondary, #6b5f52);
}

.cl-actions {
  display: flex;
}

.cl-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: var(--radius-pill);
  font-size: var(--text-body, 30rpx);
  font-weight: var(--weight-semibold, 600);
  color: var(--color-on-accent, #ffffff);
  background: linear-gradient(135deg, var(--color-accent, #d93a2b), var(--color-accent-deep, #a32318));
  box-sizing: border-box;
}

.cl-btn-hover {
  opacity: 0.85;
}

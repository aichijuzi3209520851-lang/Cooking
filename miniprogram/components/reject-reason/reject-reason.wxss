/* components/reject-reason/reject-reason.wxss */
/* 复用 app.wxss 主题变量，跟随全部主题家族 */

.rr-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: var(--color-mask);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 底部抽屉：选项列表较长，从底部弹出更顺手 */
.rr-panel {
  width: 100%;
  box-sizing: border-box;
  background: var(--surface-raised, #ffffff);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 40rpx 40rpx calc(env(safe-area-inset-bottom) + 32rpx);
}

.rr-title {
  font-size: var(--text-h3);
  font-weight: 600;
  color: var(--color-text-primary, #241b12);
  text-align: center;
  line-height: 1.4;
}

.rr-desc {
  margin-top: var(--space-1);
  font-size: var(--text-caption);
  color: var(--color-text-tertiary, #a2968a);
  text-align: center;
}

.rr-options {
  margin-top: var(--space-4);
}

.rr-option {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 var(--space-4);
  margin-bottom: var(--space-2);
  border-radius: var(--radius-md);
  background: var(--surface-sunken, #fbf5ec);
  color: var(--color-text-primary, #241b12);
  font-size: var(--text-body);
}

.rr-option:active {
  opacity: 0.75;
}

.rr-option-dashed {
  background: transparent;
  border: 2rpx dashed var(--color-border-strong, #dcc9ac);
  color: var(--color-text-secondary, #6b5f52);
}

.rr-input-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-1);
  margin-bottom: var(--space-2);
}

.rr-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  padding: 0 var(--space-3);
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: var(--surface-sunken, #fbf5ec);
  border: 2rpx solid var(--color-border-strong, #dcc9ac);
  font-size: var(--text-body);
  color: var(--color-text-primary, #241b12);
}

.rr-input-ph {
  color: var(--color-text-tertiary, #a2968a);
}

.rr-submit {
  flex-shrink: 0;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 var(--space-5);
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--color-accent, #d93a2b), var(--color-accent-deep, #a32318));
  color: var(--color-on-accent, #ffffff);
  font-size: var(--text-body);
  font-weight: var(--weight-semibold, 600);
}

/* 禁用态与其他按钮同一语言：可读灰，压「可点性」不压「可读性」 */
.rr-submit.is-disabled {
  background: var(--surface-sunken, #fbf5ec);
  color: var(--color-text-tertiary, #a2968a);
}

.rr-cancel {
  margin-top: var(--space-1);
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: var(--text-body);
  color: var(--color-text-secondary, #6b5f52);
}

/* pages/history/history.wxss
 * 与全局系统同频：日期条用 .card，间距走 --space-*，字重走 --weight-*，
 * 头像渐变统一由 utils/util.js#getAvatarGradient 提供（同人同色）
 */
.history-page {
  padding-top: var(--space-3);
  padding-bottom: var(--space-6);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 日期选择器 */
.date-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) var(--space-3);
  margin-bottom: var(--space-3);
}

.date-arrow {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-sunken);
  transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
  position: relative;
}

/* 视觉 64rpx，热区外扩至 88rpx（44px）触控底线 */
.date-arrow::after {
  content: '';
  position: absolute;
  top: -12rpx;
  left: -12rpx;
  right: -12rpx;
  bottom: -12rpx;
}

.date-arrow:active {
  transform: scale(0.92);
  opacity: 0.7;
}

.date-arrow-disabled {
  opacity: 0.3;
  pointer-events: none;
}

.date-arrow-icon {
  font-size: var(--icon-sm);
  color: var(--color-accent);
  line-height: 1;
  margin-top: -4rpx;
}

.date-display {
  flex: 1;
  display: flex;
  justify-content: center;
}

.date-text {
  font-size: var(--text-h3);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
}

/* 历史卡片：.card 自带 32rpx 内边距与 24rpx 卡距，不再另起一套 */
.history-dish-name-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}

.history-dish-name {
  font-size: var(--text-body);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
}

/* 拍板标识：今晚实际做了这道菜 */
.history-decided-chip {
  padding: 4rpx var(--space-2);
  border-radius: var(--radius-pill);
  background: var(--color-accent-soft);
  color: var(--color-accent-deep);
  font-size: var(--text-caption);
  font-weight: var(--weight-semibold);
}

.voters-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3) var(--space-4);
}

.voter-item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.voter-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.voter-avatar-text {
  font-size: var(--text-body-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-text-inverse);
}

.voter-name {
  font-size: var(--text-body-sm);
  color: var(--color-text-secondary);
}

/* 加载失败态：区分于空态，给明确的重试入口 */
.history-error {
  padding: var(--space-10) 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.history-error-text {
  font-size: var(--text-body-sm);
  color: var(--color-text-secondary);
}

.history-retry-btn {
  margin-top: var(--space-3);
  display: inline-flex;
  align-items: center;
  height: 68rpx;
  padding: 0 var(--space-5);
  border-radius: var(--radius-pill);
  background: var(--color-accent-soft);
  color: var(--color-accent-deep);
  font-size: var(--text-caption);
  font-weight: var(--weight-semibold);
}

/* 加载骨架（与历史卡同形，避免加载完成时跳动） */
.skeleton-card {
  background: var(--surface-card);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
  box-shadow: var(--elev-1);
  box-sizing: border-box;
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-xs);
  background: var(--surface-sunken);
  margin-bottom: var(--space-2);
}

.skeleton-line-title {
  width: 45%;
}

.skeleton-line-short {
  width: 30%;
  margin-bottom: 0;
}

.skeleton-shimmer {
  animation: skeleton-pulse 1.2s ease-in-out infinite;
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

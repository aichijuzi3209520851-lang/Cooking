/* pages/history/history.wxss */
.history-page {
  padding-top: 24rpx;
  padding-bottom: 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 日期选择器 */
.date-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.date-arrow {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-card-inner);
  transition: all 0.2s ease;
  position: relative;
}

/* 视觉 64rpx，热区外扩至 88rpx（44px）触控底线 */
.date-arrow::after {
  content: '';
  position: absolute;
  top: -12rpx;
  left: -12rpx;
  right: -12rpx;
  bottom: -12rpx;
}

.date-arrow:active {
  transform: scale(0.92);
  opacity: 0.7;
}

.date-arrow-disabled {
  opacity: 0.3;
  pointer-events: none;
}

.date-arrow-icon {
  font-size: 48rpx;
  color: var(--color-accent);
  line-height: 1;
  margin-top: -4rpx;
}

.date-display {
  flex: 1;
  display: flex;
  justify-content: center;
}

.date-text {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
}

/* 历史卡片 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-card {
  padding: 28rpx 32rpx;
  margin-bottom: 0;
}

.history-dish-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.history-dish-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 拍板标识：今晚实际做了这道菜 */
.history-decided-chip {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-accent-soft);
  color: var(--color-accent-deep);
  font-size: 22rpx;
  font-weight: 600;
}

.voters-row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 32rpx;
}

.voter-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.voter-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.voter-avatar-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.voter-name {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

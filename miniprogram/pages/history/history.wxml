<!--pages/history/history.wxml-->
<view class="container history-page {{themeClass}}">
  <!-- 日期选择器 -->
  <view class="date-bar card">
    <view class="date-arrow" bindtap="onPrevDay" aria-role="button" aria-label="前一天">
      <text class="date-arrow-icon">‹</text>
    </view>
    <picker
      mode="date"
      value="{{currentDate}}"
      end="{{maxDate}}"
      bindchange="onDatePick"
    >
      <view class="date-display">
        <text class="date-text">{{dateDisplay}}</text>
      </view>
    </picker>
    <view
      class="date-arrow {{canGoNext ? '' : 'date-arrow-disabled'}}"
      bindtap="onNextDay"
      aria-role="button"
      aria-label="后一天"
    >
      <text class="date-arrow-icon">›</text>
    </view>
  </view>

  <!-- 加载骨架：与历史卡同形 -->
  <block wx:if="{{loading && historyList.length === 0}}">
    <view class="skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="skeleton-line skeleton-line-title skeleton-shimmer"></view>
      <view class="skeleton-line skeleton-line-short skeleton-shimmer"></view>
    </view>
  </block>

  <!-- 加载失败：给重试入口，不冒充「没有记录」 -->
  <view wx:elif="{{loadError}}" class="history-error" bindtap="onRetryHistory">
    <text class="history-error-text">这一天的记录没加载出来</text>
    <view class="history-retry-btn">点击重试</view>
  </view>

  <!-- 历史列表 -->
  <block wx:elif="{{historyList.length > 0}}">
    <view class="history-card card" wx:for="{{historyList}}" wx:key="dishId">
      <view class="history-dish-name-row">
        <text class="history-dish-name">{{item.dishName}}</text>
        <text class="history-decided-chip" wx:if="{{item.decided}}">今晚做了</text>
      </view>
      <view class="voters-row">
        <view class="voter-item" wx:for="{{item.voters}}" wx:for-item="voter" wx:key="openid">
          <view class="voter-avatar" style="{{voter.avatarStyle}}">
            <text class="voter-avatar-text">{{voter.avatarText}}</text>
          </view>
          <text class="voter-name">{{voter.nickname}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <empty-state
    wx:else
    icon="📅"
    image="/images/empty/empty-history.svg"
    title="这一天没有点菜记录"
    description="往前翻翻其他日期吧"
  ></empty-state>
</view>

<!-- 品牌提示条：showSuccess/showError/showApiError 的渲染载体（util.js 自动路由） -->
<brand-toast id="brandToast" />

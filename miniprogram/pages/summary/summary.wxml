<!--pages/summary/summary.wxml-->
<view class="container summary-page {{themeClass}}">

  <!-- 顶部英雄区：与点菜页保持同一视觉语言
       主标题用「日期」而非「点菜汇总」——导航栏已经是「点菜汇总」，同名会重复 -->
  <view class="summary-hero">
    <view class="header">
      <view class="header-title">{{dateText}}</view>
      <view class="header-sub" wx:if="{{hasFamily && summaryList.length > 0}}">
        共 {{stats.dishCount}} 道菜 · {{stats.voterCount}} 人参与
      </view>
    </view>
  </view>

  <!-- 实时同步降级提示（T6）：watch 重试用尽后显示，数据已自动改为轮询刷新 -->
  <view wx:if="{{syncDegraded}}" class="sync-degraded-tip">
    实时同步不可用，已切换为自动刷新
  </view>

  <!-- 无家庭 -->
  <block wx:if="{{!hasFamily}}">
    <empty-state
      icon="🏠"
      image="/images/empty/empty-family.svg"
      title="先加入家庭吧"
      description="创建或加入一个家庭后即可查看汇总"
    />
  </block>

  <!-- 有家庭 -->
  <block wx:else>
    <!-- 首屏加载骨架：与 summary-card 同形，避免加载中闪现空态 -->
    <block wx:if="{{loading && summaryList.length === 0}}">
      <view class="summary-list">
        <view class="skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
          <view class="skeleton-thumb skeleton-shimmer"></view>
          <view class="skeleton-lines">
            <view class="skeleton-line skeleton-shimmer"></view>
            <view class="skeleton-line skeleton-line-short skeleton-shimmer"></view>
          </view>
        </view>
      </view>
    </block>

    <!-- 汇总列表 -->
    <block wx:elif="{{summaryList.length > 0}}">
      <view class="summary-list">
        <view
          class="summary-card"
          wx:for="{{summaryList}}"
          wx:for-index="dishIndex"
          wx:key="dishId"
        >
          <view class="summary-main">
            <!-- 左侧菜品图/emoji -->
            <view class="dish-thumb" bindtap="onPreviewImage" data-url="{{item.imageUrl}}">
              <image
                wx:if="{{item.imageUrl}}"
                class="dish-thumb-img"
                src="{{item.imageUrl}}"
                mode="aspectFill"
                data-index="{{dishIndex}}"
                binderror="onImageError"
              />
              <view wx:else class="dish-thumb-placeholder">
                <image
                  wx:if="{{item.categoryImage}}"
                  class="dish-thumb-cat"
                  src="{{item.categoryImage}}"
                  mode="aspectFit"
                  binderror="onThumbError"
                  data-index="{{dishIndex}}"
                />
                <text wx:else class="dish-thumb-emoji">{{item.categoryEmoji}}</text>
              </view>
            </view>

            <!-- 中间信息 -->
            <view class="dish-info">
              <view class="dish-name-row">
                <view class="dish-name">{{item.name}}</view>
                <view class="decided-chip" wx:if="{{item.decided}}">已加入</view>
              </view>
              <view class="voter-list">
                <view
                  class="voter-item"
                  wx:for="{{expandedVoters[item.dishId] ? item.voters : item.votersShow}}"
                  wx:for-item="voter"
                  wx:key="openid"
                >
                  <view class="voter-avatar" style="{{voter.avatarStyle}}">
                    <image
                      wx:if="{{voter.avatarUrl}}"
                      class="voter-avatar-img"
                      src="{{voter.avatarUrl}}"
                      mode="aspectFill"
                      data-dish="{{dishIndex}}"
                      data-voter="{{index}}"
                      binderror="onVoterImageError"
                    />
                    <text wx:else class="voter-avatar-text">{{voter.avatarText}}</text>
                  </view>
                  <text class="voter-name">{{voter.nickname}}</text>
                </view>
                <!-- +N 折叠：人多时收起，点一下展开全部 -->
                <view
                  wx:if="{{item.votersExtra > 0}}"
                  class="voter-extra"
                  data-id="{{item.dishId}}"
                  catchtap="onToggleVoters"
                >{{expandedVoters[item.dishId] ? '收起' : '+' + item.votersExtra}}</view>
              </view>
            </view>

            <!-- 右侧热度 -->
            <view class="dish-heat">
              <text class="heat-num">{{item.voterCount}}</text>
              <text class="heat-label">人想吃</text>
            </view>
          </view>

          <!-- 金牌大厨操作：加入/移除菜单 + 撤下 -->
          <view class="chef-actions" wx:if="{{isChef}}">
            <view
              class="decide-btn {{item.decided ? 'decide-btn-on' : ''}}"
              data-id="{{item.dishId}}"
              data-decided="{{item.decided}}"
              catchtap="onDecideMenu"
              hover-class="decide-btn-hover"
            >
              {{item.decided ? '移除菜单' : '加入菜单'}}
            </view>
            <view
              class="chef-cancel-btn"
              data-id="{{item.dishId}}"
              data-name="{{item.name}}"
              catchtap="onChefCancel"
            >
              撤下这道菜
            </view>
          </view>
        </view>
      </view>

      <!-- 提交今日菜单（NOTIFY-002）：吸底常驻操作条，长列表也不用滚到底再提交 -->
      <view class="submit-bar">
        <view class="submit-bar-inner">
          <view
            class="submit-btn {{stats.dishCount > 0 ? '' : 'is-disabled'}}"
            bindtap="onSubmitMenu"
            hover-class="submit-btn-hover"
          >{{submitted ? '重新提交给金牌大厨' : '提交今日菜单'}}</view>
          <view class="submit-hint">提交后金牌大厨会收到一条通知</view>
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <block wx:else>
      <empty-state
        icon="🍽️"
        image="/images/empty/empty-summary.svg"
        title="今天还没有人点菜"
        description="快去点几道想吃的菜吧"
      />
    </block>
  </block>

</view>

<!-- 隐私协议授权弹窗（PRIV-001） -->
<privacy-popup />
<!-- 一票否决原因选择（NOTIFY-002） -->
<reject-reason
  visible="{{showReject}}"
  dish-name="{{rejectDishName}}"
  bind:confirm="onRejectConfirm"
  bind:cancel="onRejectCancel"
/>

<!-- 版本更新公告弹窗（每版本进入小程序弹一次，自包含组件） -->
<changelog-popup class="cl-popup-host" />

<!-- 品牌提示条：showSuccess/showError/showApiError 的渲染载体（util.js 自动路由） -->
<brand-toast id="brandToast" />

/* pages/summary/summary.wxss
 * 与 menu 页共用同一套节奏：英雄区 → 卡片列表（32rpx 内边距 / 24rpx 间距）
 */
.summary-page {
  padding-top: 0;
  padding-bottom: var(--space-6);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 英雄区 ===== */
.summary-hero {
  margin: 0 calc(var(--space-4) * -1) var(--space-4);
  padding: var(--space-3) var(--space-4) var(--space-4);
  background: linear-gradient(160deg, var(--tint-1) 0%, var(--tint-2) 55%, var(--tint-3) 100%);
  border-bottom-left-radius: var(--radius-xl);
  border-bottom-right-radius: var(--radius-xl);
}

.header {
  padding: 0;
}

.header-title {
  font-size: var(--text-h1);
  font-weight: var(--weight-black);
  color: var(--color-text-primary);
  letter-spacing: -0.5rpx;
  line-height: var(--lh-tight);
}

.header-sub {
  margin-top: var(--space-1);
  font-size: var(--text-caption);
  color: var(--color-text-secondary);
}

/* ===== 汇总卡片 ===== */
.summary-list {
  padding-top: var(--space-1);
}

.summary-card {
  background: var(--surface-card);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
  box-shadow: var(--elev-1);
  box-sizing: border-box;
}

.summary-main {
  display: flex;
  align-items: flex-start;
}

/* 左侧缩略图 */
.dish-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  margin-right: var(--space-3);
  background: var(--surface-sunken);
  transition: transform var(--dur-fast) var(--ease-out);
}

.dish-thumb:active {
  transform: scale(0.94);
}

.dish-thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.dish-thumb-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-cream);
}

.dish-thumb-cat {
  width: 68%;
  height: 68%;
}

.dish-thumb-emoji {
  font-size: 48rpx;
  line-height: 1;
}

/* 中间信息 */
.dish-info {
  flex: 1;
  min-width: 0;
  margin-right: var(--space-2);
}

.dish-name-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
  margin-bottom: var(--space-2);
}

.dish-name {
  font-size: var(--text-h3);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 拍板标识：金牌大厨定的今晚菜单 */
.decided-chip {
  flex-shrink: 0;
  padding: 4rpx var(--space-2);
  border-radius: var(--radius-pill);
  background: var(--color-accent-soft);
  color: var(--color-accent-deep);
  font-size: var(--text-mini);
  font-weight: var(--weight-semibold);
  line-height: 1.4;
}

.voter-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2) var(--space-3);
}

.voter-item {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.voter-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.voter-avatar-img {
  width: 100%;
  height: 100%;
}

.voter-avatar-text {
  font-size: var(--text-mini);
  font-weight: var(--weight-semibold);
  color: #FFFFFF;
  line-height: 1;
}

.voter-name {
  font-size: var(--text-caption);
  color: var(--color-text-secondary);
  line-height: 1.2;
}

/* 右侧热度：数字与标签左对齐成组，避免与信息区错位 */
.dish-heat {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 96rpx;
}

.heat-num {
  font-size: var(--text-h1);
  font-weight: var(--weight-black);
  /* 用 num-strong 而非 accent：金色等浅强调色下依然 ≥3:1 */
  color: var(--color-num-strong);
  line-height: 1;
}

.heat-label {
  font-size: var(--text-mini);
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

/* 金牌大厨操作行：主操作（定菜）撑满左侧，破坏性操作（撤下）靠右且不抢焦点 */
.chef-actions {
  margin-top: var(--space-3);
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--hairline);
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

/* 拍板按钮：主操作，撑满剩余宽度（与全局按钮同高 72rpx） */
.decide-btn {
  flex: 1;
  height: 72rpx;
  line-height: 68rpx;
  padding: 0 var(--space-4);
  border-radius: var(--radius-pill);
  border: 2rpx solid var(--color-accent);
  color: var(--color-accent-deep);
  font-size: var(--text-caption);
  font-weight: var(--weight-semibold);
  text-align: center;
  box-sizing: border-box;
  transition: transform var(--dur-fast) var(--ease-out);
}

.decide-btn-on {
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  color: var(--color-on-accent);
  border-color: transparent;
  box-shadow: var(--elev-accent);
}

.decide-btn-hover {
  opacity: 0.75;
  transform: scale(0.97);
}

/* chef 撤下按钮：破坏性操作，弱化为文字按钮，固定宽度不参与伸缩 */
.chef-cancel-btn {
  flex-shrink: 0;
  padding: var(--space-2) var(--space-1);
  text-align: center;
  font-size: var(--text-caption);
  color: var(--color-danger);
  font-weight: var(--weight-medium);
}

.chef-cancel-btn:active {
  opacity: 0.6;
}

/* ===== 提交今日菜单（NOTIFY-002）：汇总今日点菜并通知金牌大厨 ===== */
/* 统计信息已上移到顶部英雄区，底部只保留提交操作与安全区留白 */
.submit-bar {
  padding: var(--space-6) var(--space-4) var(--space-3);
  padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom));
}

.submit-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 46rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: var(--text-body);
  font-weight: var(--weight-bold);
  box-shadow: var(--shadow-accent);
}

.submit-btn-hover {
  opacity: 0.88;
}

.submit-btn.is-disabled {
  opacity: 0.45;
  box-shadow: none;
}

.submit-hint {
  margin-top: var(--space-2);
  text-align: center;
  font-size: var(--text-caption);
  color: var(--color-text-tertiary);
}

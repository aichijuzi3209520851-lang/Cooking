/* pages/changelog/changelog.wxss */
.changelog-page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.cl-card {
  background: var(--surface-card);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.cl-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.cl-version-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cl-version {
  font-size: var(--text-lg, 38rpx);
  font-weight: 800;
  color: var(--color-text-primary);
}

.cl-current-tag {
  font-size: var(--text-mini);
  font-weight: 600;
  color: var(--color-on-accent);
  background: var(--color-accent);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.cl-date {
  font-size: var(--text-mini);
  color: var(--color-text-tertiary);
}

.cl-card-title {
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.cl-card-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 8rpx 0;
}

.cl-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-accent);
  margin-top: 18rpx;
}

.cl-change {
  font-size: var(--text-sm);
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.cl-footer {
  text-align: center;
  padding: 16rpx 0 0;
  color: var(--color-text-tertiary);
}

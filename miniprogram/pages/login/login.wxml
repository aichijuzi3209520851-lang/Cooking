<view class="login-page {{themeClass}}">
  <view class="login-top-space"></view>

  <!-- 背景光晕（静态，径向渐变替代 blur，低端机友好） -->
  <view class="login-glow login-glow-a"></view>
  <view class="login-glow login-glow-b"></view>

  <!-- 漂浮装饰层：随手机倾斜轻微视差，纯装饰不响应点击 -->
  <view class="float-layer" style="transform: translate3d({{px * 14}}rpx, {{py * 14}}rpx, 0);">
    <image class="float-icon float-1 drift-a" src="/images/login/chili.svg" mode="aspectFit" />
    <image class="float-icon float-2 drift-c" src="/images/login/rice.svg" mode="aspectFit" />
    <image class="float-icon float-3 drift-b" src="/images/login/bokchoy.svg" mode="aspectFit" />
    <image class="float-icon float-4 drift-d" src="/images/login/mug.svg" mode="aspectFit" />
    <image class="float-icon float-5 drift-a" src="/images/login/fish.svg" mode="aspectFit" />
    <image class="float-icon float-6 drift-b" src="/images/login/tomato.svg" mode="aspectFit" />
    <image class="float-icon float-7 drift-d" src="/images/login/soup.svg" mode="aspectFit" />
  </view>

  <view class="login-brand" style="transform: translate3d({{px * -8}}rpx, {{py * -8}}rpx, 0);">
    <view class="login-mark">
      <text class="login-mark-emoji">🍳</text>
      <view class="login-mark-spark login-mark-spark-one"></view>
      <view class="login-mark-spark login-mark-spark-two"></view>
    </view>
    <view class="login-title">今天<text class="login-title-accent">吃啥</text></view>
    <view class="login-subtitle">一家人的今日菜单，从这一餐开始</view>
  </view>

  <view class="login-panel">
    <view class="login-panel-title">登录，开始安排今天</view>

    <view wx:if="{{status === 'failed'}}" class="login-error">
      <text class="login-error-icon">!</text>
      <text class="login-error-text">{{loginError}}</text>
    </view>

    <button
      wx:if="{{status === 'failed'}}"
      class="login-button login-button-retry"
      bindtap="onLoginTap"
      loading="{{logging}}"
      disabled="{{logging}}"
    >
      重新登录
    </button>
    <button
      wx:elif="{{status === 'loading'}}"
      class="login-button"
      loading="{{true}}"
      disabled="{{true}}"
    >
      登录中...
    </button>
    <button
      wx:else
      class="login-button"
      bindtap="onLoginTap"
      loading="{{logging}}"
      disabled="{{logging}}"
    >
      <text>{{logging ? '登录中...' : '微信快捷登录'}}</text>
    </button>

    <view class="login-safe-note">登录后即可创建或加入家庭</view>
  </view>
</view>

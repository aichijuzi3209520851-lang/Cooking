/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding: 0 48rpx calc(env(safe-area-inset-bottom) + 44rpx);
  background:
    linear-gradient(180deg, var(--color-bg-secondary) 0%, var(--color-bg) 58%, var(--color-cream) 100%);
}

.login-top-space {
  /* 自定义导航（navigationStyle: custom）后需自行避让状态栏/刘海 */
  height: calc(env(safe-area-inset-top) + 48rpx);
  flex-shrink: 0;
}

/* ===== 品牌区：占据剩余空间并垂直居中，让页面重心落在中部 ===== */
.login-brand {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.login-mark {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  border-radius: 52rpx;
  background: var(--color-cream);
  border: 2rpx solid rgba(217, 58, 43, 0.12);
  box-shadow: var(--shadow-float);
  transform: rotate(-4deg);
}

.login-mark::after {
  content: '';
  position: absolute;
  right: -18rpx;
  bottom: -12rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--color-primary-orange);
  opacity: 0.9;
}

.login-mark-emoji {
  position: relative;
  z-index: 1;
  font-size: 92rpx;
  line-height: 1;
  transform: rotate(4deg);
}

.login-mark-spark {
  position: absolute;
  z-index: 2;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-accent);
}

.login-mark-spark-one {
  top: 26rpx;
  left: 34rpx;
}

.login-mark-spark-two {
  top: 48rpx;
  right: 28rpx;
  width: 8rpx;
  height: 8rpx;
  background: var(--color-primary-orange);
}

.login-title {
  color: var(--color-text-primary);
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.login-title-accent {
  color: var(--color-accent);
}

.login-subtitle {
  margin-top: 20rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

/* ===== 登录卡片：内容居中，加大内边距与圆角，观感更聚拢 ===== */
.login-panel {
  width: 100%;
  box-sizing: border-box;
  padding: 48rpx 44rpx 42rpx;
  border-radius: 40rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-float);
  text-align: center;
}

.login-panel-kicker {
  color: var(--color-accent);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.login-panel-title {
  margin-top: 14rpx;
  color: var(--color-text-primary);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.35;
}

.login-panel-copy {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

.login-button {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  border: none;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  color: var(--color-on-accent);
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: var(--shadow-accent);
}

.login-button::after {
  border: none;
}

.login-button:active {
  opacity: 0.88;
  transform: scale(0.985);
}

.login-button-retry {
  background: var(--color-card);
  color: var(--color-accent-deep);
  border: 3rpx solid var(--color-accent);
  box-shadow: var(--shadow-card);
}

.login-safe-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 24rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.login-safe-dot {
  color: var(--color-primary-green);
  font-size: 18rpx;
}

.login-error {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 26rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-md);
  /* 错误提示配色固定为红系，不随强调色漂移；长文案保持左对齐易读 */
  background: rgba(224, 32, 32, 0.08);
  border: 1rpx solid rgba(224, 32, 32, 0.20);
  text-align: left;
}

.login-error-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-primary-red);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
}

.login-error-text {
  flex: 1;
  min-width: 0;
  color: var(--color-primary-red);
  font-size: 24rpx;
  line-height: 1.5;
}

/* ===== 底部标语 ===== */
.login-footer {
  margin-top: 44rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

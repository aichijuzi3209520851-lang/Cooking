/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding: 0 48rpx calc(env(safe-area-inset-bottom) + 48rpx);
  background:
    linear-gradient(180deg, var(--color-bg-secondary) 0%, var(--color-bg) 58%, var(--color-cream) 100%);
}

.login-top-space {
  height: 92rpx;
  flex-shrink: 0;
}

.login-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-mark {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  border-radius: 56rpx;
  background: var(--color-cream);
  border: 2rpx solid rgba(217, 58, 43, 0.12);
  box-shadow: var(--shadow-float);
  transform: rotate(-4deg);
}

.login-mark::after {
  content: '';
  position: absolute;
  right: -18rpx;
  bottom: -12rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--color-primary-orange);
  opacity: 0.9;
}

.login-mark-emoji {
  position: relative;
  z-index: 1;
  font-size: 96rpx;
  line-height: 1;
  transform: rotate(4deg);
}

.login-mark-spark {
  position: absolute;
  z-index: 2;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-accent);
}

.login-mark-spark-one {
  top: 26rpx;
  left: 34rpx;
}

.login-mark-spark-two {
  top: 48rpx;
  right: 28rpx;
  width: 8rpx;
  height: 8rpx;
  background: var(--color-primary-orange);
}

.login-title {
  color: var(--color-text-primary);
  font-size: 68rpx;
  font-weight: 800;
  line-height: 1.2;
}

.login-title-accent {
  color: var(--color-accent);
}

.login-subtitle {
  margin-top: 18rpx;
  color: var(--color-text-secondary);
  font-size: 27rpx;
  line-height: 1.5;
}

.login-panel {
  width: 100%;
  box-sizing: border-box;
  margin-top: 76rpx;
  padding: 40rpx 36rpx 34rpx;
  border-radius: 32rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-float);
}

.login-panel-kicker {
  color: var(--color-accent);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.login-panel-title {
  margin-top: 14rpx;
  color: var(--color-text-primary);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.35;
}

.login-panel-copy {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

.login-button {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 36rpx;
  border: none;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: var(--shadow-accent);
}

.login-button::after {
  border: none;
}

.login-button:active {
  opacity: 0.88;
  transform: scale(0.985);
}

.login-button-retry {
  background: var(--color-card);
  color: var(--color-accent-deep);
  border: 3rpx solid var(--color-accent);
  box-shadow: var(--shadow-card);
}

.login-button-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  font-size: 18rpx;
  font-weight: 700;
}

.login-safe-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 26rpx;
  color: var(--color-text-tertiary);
  font-size: 23rpx;
}

.login-safe-dot {
  color: var(--color-primary-green);
  font-size: 18rpx;
}

.login-error {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 28rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--color-accent-soft);
}

.login-error-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
}

.login-error-text {
  flex: 1;
  min-width: 0;
  color: var(--color-primary);
  font-size: 24rpx;
  line-height: 1.5;
}

.login-footer {
  margin-top: auto;
  padding-top: 44rpx;
  color: var(--color-text-tertiary);
  font-size: 23rpx;
}

/* pages/login/login.wxss */
.login-page {
  /* 氛围装饰令牌：光晕色与漂浮图标透明度（深色模式自动调暗） */
  --glow-a: rgba(230, 162, 60, 0.16);
  --glow-b: rgba(217, 58, 43, 0.10);
  --float-opacity: 0.8;

  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding: 0 48rpx calc(env(safe-area-inset-bottom) + 44rpx);
  background:
    linear-gradient(180deg, var(--color-bg-secondary) 0%, var(--color-bg) 58%, var(--color-cream) 100%);
  overflow: hidden;
  position: relative;
}

@media (prefers-color-scheme: dark) {
  .login-page {
    --glow-a: rgba(217, 166, 72, 0.08);
    --glow-b: rgba(232, 86, 74, 0.10);
    --float-opacity: 0.45;
  }
}

.login-page.theme-dark {
  --glow-a: rgba(217, 166, 72, 0.08);
  --glow-b: rgba(232, 86, 74, 0.10);
  --float-opacity: 0.45;
}

/* 清新绿意主题：光晕与漂浮物转绿色调（优先级高于深色媒体查询兜底） */
.login-page.theme-fresh {
  --glow-a: rgba(47, 158, 110, 0.14);
  --glow-b: rgba(47, 158, 110, 0.08);
  --float-opacity: 0.8;
}

/* 系统深色下手动选温馨暖调：保持亮色氛围，不被媒体查询压暗 */
.login-page.theme-warm {
  --glow-a: rgba(230, 162, 60, 0.16);
  --glow-b: rgba(217, 58, 43, 0.10);
  --float-opacity: 0.8;
}

.login-top-space {
  /* 自定义导航（navigationStyle: custom）后需自行避让状态栏/刘海 */
  height: calc(env(safe-area-inset-top) + 48rpx);
  flex-shrink: 0;
}

/* ===== 氛围装饰：光晕（径向渐变替代 blur 滤镜，低端机零额外开销） ===== */
.login-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.login-glow-a {
  width: 440rpx;
  height: 440rpx;
  top: -140rpx;
  left: -120rpx;
  background: radial-gradient(circle, var(--glow-a) 0%, transparent 68%);
}

.login-glow-b {
  width: 400rpx;
  height: 400rpx;
  right: -130rpx;
  top: 32%;
  background: radial-gradient(circle, var(--glow-b) 0%, transparent 68%);
}

/* ===== 漂浮图标层：只动 transform，随重力轻微视差 ===== */
.float-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  z-index: 0;
  transition: transform 0.35s ease-out;
}

.float-icon {
  position: absolute;
  opacity: var(--float-opacity);
}

.float-1 { width: 64rpx; height: 64rpx; top: 9%;  left: 13%; }
.float-2 { width: 58rpx; height: 58rpx; top: 7%;  right: 30%; }
.float-3 { width: 84rpx; height: 84rpx; top: 17%; right: 8%; }
.float-4 { width: 58rpx; height: 58rpx; top: 31%; left: 4%; }
.float-5 { width: 76rpx; height: 76rpx; top: 38%; right: 5%; }
.float-6 { width: 56rpx; height: 56rpx; top: 48%; left: 6%; }
.float-7 { width: 68rpx; height: 68rpx; top: 46%; right: 20%; }

/* 4 组漂浮轨迹：时长错开 + 负延迟错帧，观感是「轻轻漂」而不是「乱飞」 */
.drift-a { animation: driftA 9.8s ease-in-out infinite; }
.drift-b { animation: driftB 11.5s ease-in-out infinite; }
.drift-c { animation: driftC 10.2s ease-in-out infinite; }
.drift-d { animation: driftD 12.4s ease-in-out infinite; }

@keyframes driftA {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  30% { transform: translate3d(16rpx, -30rpx, 0) rotate(5deg); }
  65% { transform: translate3d(-12rpx, 16rpx, 0) rotate(-4deg); }
}

@keyframes driftB {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  35% { transform: translate3d(-16rpx, -26rpx, 0) rotate(-6deg); }
  70% { transform: translate3d(12rpx, 14rpx, 0) rotate(4deg); }
}

@keyframes driftC {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  40% { transform: translate3d(10rpx, -28rpx, 0) rotate(3deg); }
  78% { transform: translate3d(-14rpx, 14rpx, 0) rotate(-5deg); }
}

@keyframes driftD {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  25% { transform: translate3d(14rpx, -22rpx, 0) rotate(4deg); }
  55% { transform: translate3d(-14rpx, 12rpx, 0) rotate(-3deg); }
  85% { transform: translate3d(8rpx, -10rpx, 0) rotate(2deg); }
}

/* ===== 品牌区：占据剩余空间并垂直居中，与漂浮层做反向视差 ===== */
.login-brand {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  position: relative;
  z-index: 1;
  transition: transform 0.35s ease-out;
}

.login-mark {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  border-radius: 52rpx;
  background: var(--color-cream);
  border: 2rpx solid rgba(217, 58, 43, 0.12);
  box-shadow: var(--shadow-float);
  transform: rotate(-4deg);
}

.login-mark::after {
  content: '';
  position: absolute;
  right: -18rpx;
  bottom: -12rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--color-primary-orange);
  opacity: 0.9;
}

.login-mark-emoji {
  position: relative;
  z-index: 1;
  font-size: 92rpx;
  line-height: 1;
  transform: rotate(4deg);
}

.login-mark-spark {
  position: absolute;
  z-index: 2;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-accent);
}

.login-mark-spark-one {
  top: 26rpx;
  left: 34rpx;
}

.login-mark-spark-two {
  top: 48rpx;
  right: 28rpx;
  width: 8rpx;
  height: 8rpx;
  background: var(--color-primary-orange);
}

.login-title {
  color: var(--color-text-primary);
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.login-title-accent {
  color: var(--color-accent);
}

.login-subtitle {
  margin-top: 20rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

/* ===== 登录卡片：内容居中，层级只有 标题 → 按钮 → 一行说明 ===== */
.login-panel {
  width: 100%;
  box-sizing: border-box;
  padding: 44rpx 44rpx 40rpx;
  border-radius: 40rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-float);
  text-align: center;
  position: relative;
  z-index: 1;
}

.login-panel-title {
  color: var(--color-text-primary);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.35;
}

.login-button {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  border: none;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  color: var(--color-on-accent);
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: var(--shadow-accent);
}

.login-button::after {
  border: none;
}

.login-button:active {
  opacity: 0.88;
  transform: scale(0.985);
}

.login-button-retry {
  background: var(--color-card);
  color: var(--color-accent-deep);
  border: 3rpx solid var(--color-accent);
  box-shadow: var(--shadow-card);
}

/* 唯一保留的微文案：告知登录后发生什么 */
.login-safe-note {
  margin-top: 24rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.login-error {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 26rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-md);
  /* 错误提示配色固定为红系，不随强调色漂移；长文案保持左对齐易读 */
  background: rgba(224, 32, 32, 0.08);
  border: 1rpx solid rgba(224, 32, 32, 0.20);
  text-align: left;
}

.login-error-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-primary-red);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
}

.login-error-text {
  flex: 1;
  min-width: 0;
  color: var(--color-primary-red);
  font-size: 24rpx;
  line-height: 1.5;
}

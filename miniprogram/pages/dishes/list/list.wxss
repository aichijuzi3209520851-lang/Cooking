/* pages/dishes/list/list.wxss */
.list-page {
  padding-top: 24rpx;
  /* 页尾留白覆盖 FAB（112rpx）+ 底距 + 安全区，「没有更多了」不被遮挡 */
  padding-bottom: calc(env(safe-area-inset-bottom) + 240rpx);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 分类筛选 */
.category-scroll {
  white-space: nowrap;
  margin: 0 -32rpx;
  padding: 8rpx 32rpx 16rpx;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 32rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  border-radius: var(--radius-pill);
  background: var(--color-card);
  box-shadow: var(--shadow-card);
  transition: opacity 0.2s ease;
  flex-shrink: 0;
}

.category-chip:active {
  opacity: 0.7;
}

.category-chip-active {
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  box-shadow: var(--shadow-accent);
}

.category-chip-emoji {
  font-size: 28rpx;
  line-height: 1;
}

.category-chip-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.category-chip-active .category-chip-name {
  color: var(--color-on-accent);
}

/* 菜品列表 */
.dish-list {
  margin-top: 16rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 16rpx;
  transition: background 0.2s ease;
}

.dish-item:active {
  background: var(--color-bg-tertiary);
}

.dish-item-hidden {
  opacity: 0.45;
}

/* 缩略图 */
.dish-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 24rpx;
  background: var(--color-card-inner);
}

.dish-thumb-img {
  width: 100%;
  height: 100%;
}

.dish-thumb-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-card-inner);
}

.dish-thumb-cat {
  width: 72%;
  height: 72%;
}

.dish-thumb-emoji {
  font-size: 48rpx;
  line-height: 1;
}

/* 菜品信息 */
.dish-info {
  flex: 1;
  min-width: 0;
}

.dish-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-hidden-badge {
  background: var(--color-bg-tertiary);
  color: var(--color-text-secondary);
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  flex-shrink: 0;
}

.dish-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dish-category {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 累计被点次数：情感化展示 */
.dish-cookcount {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 编辑按钮 */
.dish-edit {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  margin-left: 8rpx;
  font-size: 26rpx;
  color: var(--color-accent-deep);
  border-radius: var(--radius-pill);
  position: relative;
}

/* 热区外扩至 ≥88rpx（44px） */
.dish-edit::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
}

.dish-edit:active {
  background: var(--color-accent-soft);
}

/* 列表底部 */
.list-footer {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.list-error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 96rpx 0;
}

/* 悬浮按钮：.fab 已提升为 app.wxss 全局类，此处不再重复定义 */

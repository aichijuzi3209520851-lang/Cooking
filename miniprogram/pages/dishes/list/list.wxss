/* pages/dishes/list/list.wxss
 * 菜品库：胶囊筛选 + 卡片列表。间距与 menu 页保持一致（24rpx 卡片间距 / 32rpx 内边距）
 */
.list-page {
  padding-top: var(--space-3);
  /* 页尾留白覆盖 FAB（112rpx）+ 底距 + 安全区，「没有更多了」不被遮挡 */
  padding-bottom: calc(env(safe-area-inset-bottom) + 240rpx);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 分类筛选 */
.category-scroll {
  white-space: nowrap;
  margin: 0 calc(var(--space-4) * -1);
  padding: var(--space-1) var(--space-4) var(--space-3);
}

.category-list {
  display: inline-flex;
  gap: var(--space-2);
  padding-right: var(--space-4);
}

.category-chip {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  padding: 14rpx var(--space-4);
  border-radius: var(--radius-pill);
  background: var(--surface-card);
  box-shadow: var(--elev-1);
  transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
  flex-shrink: 0;
}

.category-chip:active {
  opacity: 0.7;
  transform: scale(0.96);
}

.category-chip-active {
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  box-shadow: var(--elev-accent);
}

.category-chip-emoji {
  font-size: var(--text-body-sm);
  line-height: 1;
}

.category-chip-name {
  font-size: var(--text-body-sm);
  font-weight: var(--weight-medium);
  color: var(--color-text-primary);
  line-height: 1.3;
}

.category-chip-active .category-chip-name {
  color: var(--color-on-accent);
  font-weight: var(--weight-semibold);
}

/* 菜品列表 */
.dish-list {
  margin-top: var(--space-1);
}

.dish-item {
  display: flex;
  align-items: center;
  background: var(--surface-card);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  margin-bottom: var(--space-3);
  box-shadow: var(--elev-1);
  box-sizing: border-box;
  transition: background var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
}

.dish-item:active {
  background: var(--surface-sunken);
  transform: scale(0.995);
}

.dish-item-hidden {
  opacity: 0.45;
}

/* 缩略图 */
.dish-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  margin-right: var(--space-3);
  background: var(--surface-sunken);
}

.dish-thumb-img {
  width: 100%;
  height: 100%;
}

.dish-thumb-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-cream);
}

.dish-thumb-cat {
  width: 72%;
  height: 72%;
}

.dish-thumb-emoji {
  font-size: 48rpx;
  line-height: 1;
}

/* 菜品信息 */
.dish-info {
  flex: 1;
  min-width: 0;
}

.dish-name-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
}

.dish-name {
  font-size: var(--text-h3);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-hidden-badge {
  background: var(--surface-sunken);
  color: var(--color-text-secondary);
  font-size: var(--text-mini);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  flex-shrink: 0;
}

.dish-meta {
  margin-top: var(--space-2);
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.dish-category {
  font-size: var(--text-caption);
  color: var(--color-text-secondary);
}

/* 累计被点次数：情感化展示 */
.dish-cookcount {
  font-size: var(--text-mini);
  color: var(--color-text-tertiary);
}

/* 编辑按钮：淡底胶囊，与「删除」等危险操作明确区分 */
.dish-edit {
  flex-shrink: 0;
  padding: 14rpx var(--space-4);
  margin-left: var(--space-1);
  font-size: var(--text-caption);
  font-weight: var(--weight-semibold);
  color: var(--color-accent-deep);
  background: var(--color-accent-soft);
  border-radius: var(--radius-pill);
  position: relative;
  transition: transform var(--dur-fast) var(--ease-out);
}

/* 热区外扩至 ≥88rpx（44px） */
.dish-edit::after {
  content: '';
  position: absolute;
  top: -10rpx;
  left: -12rpx;
  right: -12rpx;
  bottom: -10rpx;
}

.dish-edit:active {
  opacity: 0.75;
  transform: scale(0.96);
}

/* 列表底部 */
.list-footer {
  display: flex;
  justify-content: center;
  padding: var(--space-4) 0;
}

.list-error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-12) 0;
}

/* 悬浮按钮：.fab 已提升为 app.wxss 全局类，此处不再重复定义 */

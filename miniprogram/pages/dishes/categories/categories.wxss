/* pages/dishes/categories/categories.wxss
 * 整页版分类管理：上方分类列表（可删），下方新增区（输入 + 5×5 图标方阵）
 * 通用类（.card / .section-head / .btn / .input）来自 app.wxss，此处只写页面专有部分
 */
.cate-page {
  padding-bottom: var(--space-8);
}

.cate-count {
  font-size: var(--text-caption);
  color: var(--color-text-tertiary);
  font-weight: var(--weight-medium);
}

/* ===== 现有分类列表 ===== */
.cate-list-card {
  padding: var(--space-2) var(--space-4);
}

.cate-row {
  display: flex;
  align-items: center;
  padding: var(--space-3) 0;
  border-bottom: 1rpx solid var(--hairline);
}

.cate-row:last-child {
  border-bottom: none;
}

.cate-row-emoji {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  flex-shrink: 0;
  margin-right: var(--space-3);
  border-radius: var(--radius-sm);
  background: var(--color-cream);
  font-size: 38rpx;
}

.cate-row-info {
  flex: 1;
  min-width: 0;
}

.cate-row-name {
  display: block;
  font-size: var(--text-body);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
}

.cate-row-meta {
  display: block;
  margin-top: 4rpx;
  font-size: var(--text-mini);
  color: var(--color-text-tertiary);
}

.cate-del {
  flex-shrink: 0;
  padding: 12rpx var(--space-4);
  border-radius: var(--radius-pill);
  background: var(--color-accent-soft);
  color: var(--color-accent-deep);
  font-size: var(--text-caption);
  font-weight: var(--weight-semibold);
  line-height: 1.3;
}

.cate-del-press {
  opacity: 0.75;
}

/* 不可删（有菜品 / 只剩一个分类）：降饱和但仍可点击，点了会说明原因 */
.cate-del-off {
  background: var(--surface-sunken);
  color: var(--color-text-tertiary);
}

.cate-hint {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--text-mini);
  color: var(--color-text-tertiary);
  line-height: var(--lh-normal);
}

.cate-add-head {
  margin-top: var(--space-5);
}

/* ===== 新增分类 ===== */
.cate-input-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

/* 当前图标的放大预览：与方阵里的选中态呼应，明确「会用这个图标」 */
.cate-preview {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  background: var(--color-cream);
  font-size: 48rpx;
}

.cate-input {
  flex: 1;
  min-width: 0;
}

.cate-add-btn {
  flex-shrink: 0;
  width: 160rpx;
  padding: 0;
}

.cate-picker-label {
  margin: var(--space-4) 0 var(--space-2);
  font-size: var(--text-caption);
  font-weight: var(--weight-semibold);
  color: var(--color-text-secondary);
}

/* 图标方阵：5 列等宽自动换行（gap 占 4 份），一屏铺开、无需横向滚动 */
.cate-picker {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.cate-picker-item {
  width: calc((100% - var(--space-2) * 4) / 5);
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: var(--surface-sunken);
  border: 2rpx solid transparent;
  font-size: 44rpx;
  line-height: 1;
  transition: transform var(--dur-fast) var(--ease-out);
}

.cate-picker-item:active {
  transform: scale(0.92);
}

.cate-picker-active {
  background: var(--color-accent-soft);
  border-color: var(--color-accent);
}

.cate-tip {
  display: block;
  margin-top: var(--space-3);
  font-size: var(--text-mini);
  color: var(--color-text-tertiary);
  line-height: var(--lh-normal);
}

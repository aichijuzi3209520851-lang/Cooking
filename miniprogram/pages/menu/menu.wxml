<!--pages/menu/menu.wxml-->
<view class="container menu-page {{themeClass}}">

  <!-- 顶部英雄区：主题签名色淡染，强化首屏视觉层级 -->
  <view class="menu-hero">
    <view class="header">
      <view class="header-left">
        <view class="header-title">筷点吃饭</view>
        <view class="header-sub">
          <text>{{dateText}}</text>
          <text wx:if="{{currentFamily}}" class="header-dot">·</text>
          <text wx:if="{{currentFamily}}" class="header-family">{{currentFamily.name}}</text>
        </view>
      </view>
      <view
        class="header-right"
        wx:if="{{currentFamily}}"
        catchtap="onFamilyTap"
      >
        <text class="switch-text">{{currentFamily.name}}</text>
        <text class="switch-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 米饭引导：米饭已回归「主食」分类里的普通菜品（谁想吃谁点），
       这里只在主食里确实没有米饭时提示厨师补一道 -->
  <view
    class="rice-tip"
    wx:if="{{showRiceTip && !libraryEmpty}}"
    hover-class="rice-tip-press"
    bindtap="onCreateRiceDish"
  >
    <image class="rice-tip-icon" src="/images/category/cat-staple.svg" mode="aspectFit" />
    <text class="rice-tip-text">主食里还没有米饭，点这里加一道</text>
    <text class="rice-tip-arrow">›</text>
  </view>

  <!-- 今日推荐（RECOMMEND-001）：横向卡片，不随推荐条数长高，把纵向空间留给菜品列表 -->
  <view class="recommend-card" wx:if="{{recommend.show && !libraryEmpty}}">
    <view class="recommend-head">
      <text class="recommend-title">今日推荐</text>
      <text class="recommend-season">{{recommend.seasonTip}}</text>
    </view>

    <scroll-view wx:if="{{recommend.items.length > 0}}" class="recommend-scroll" scroll-x>
      <view class="recommend-track">
        <view
          class="recommend-item {{item.voted ? 'recommend-item-done' : ''}}"
          wx:for="{{recommend.items}}"
          wx:key="dishId"
          data-index="{{index}}"
          bindtap="onRecommendTap"
        >
          <view class="recommend-thumb">
            <image
              wx:if="{{item.imageUrl}}"
              class="recommend-thumb-img"
              src="{{item.imageUrl}}"
              mode="aspectFill"
            />
            <text wx:else class="recommend-thumb-emoji">{{item.emoji}}</text>
            <view class="recommend-flag">{{item.voted ? '✓' : '＋'}}</view>
          </view>
          <text class="recommend-name">{{item.name}}</text>
          <text class="recommend-reason {{item.seasonal ? 'recommend-reason-seasonal' : ''}}">{{item.reason}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 未到开启门槛：给进度而不是留白，让用户知道推荐会自己来 -->
    <view wx:else class="recommend-progress">
      <text class="recommend-progress-text">{{recommend.progressText}}</text>
    </view>
  </view>

  <!-- 无家庭 -->
  <block wx:if="{{!hasFamily}}">
    <empty-state
      icon="🏠"
      image="/images/empty/empty-family.svg"
      title="先加入家庭吧"
      description="创建或加入一个家庭后即可开始点菜"
    />
  </block>

  <block wx:elif="{{libraryEmpty}}">
    <!-- 菜品库为空 -->
    <empty-state
      wx:if="{{isChef}}"
      icon="🍳"
      image="/images/empty/empty-dishes.svg"
      title="还没有菜品"
      description="点击右下角添加菜品"
    />
    <empty-state
      wx:else
      icon="🍽️"
      image="/images/empty/empty-dishes.svg"
      title="金牌大厨还没添加菜品"
      description="耐心等待一下吧"
    />
  </block>

  <block wx:else>
    <!-- 统计栏 -->
    <view class="stats-bar">
      <text class="stats-text">已点 <text class="stats-num">{{stats.dishCount}}</text> 道菜</text>
      <text class="stats-dot">·</text>
      <text class="stats-text"><text class="stats-num">{{stats.voterCount}}</text> 人参与</text>
    </view>
    <text wx:if="{{isChef}}" class="chef-hint">长按菜品卡片可撤下这道菜</text>

    <!-- 主体：左侧分类导航（像 Word 的导航窗格）+ 右侧菜品列表，两侧各自独立滚动 -->
    <view class="menu-body">
      <view class="category-rail">
        <scroll-view
          class="rail-scroll"
          scroll-y
          scroll-into-view="{{railIntoView}}"
          scroll-with-animation
        >
          <view
            wx:for="{{categories}}"
            wx:key="key"
            id="rail-{{item.key}}"
            class="rail-item {{selectedCategory === item.key ? 'rail-item-active' : ''}}"
            data-key="{{item.key}}"
            bindtap="onCategoryTap"
          >
            <text class="rail-emoji">{{item.emoji}}</text>
            <text class="rail-name">{{item.name}}</text>
          </view>
          <view class="rail-pad"></view>
        </scroll-view>

        <!-- 分类管理入口固定在左栏底部（仅金牌大厨）：不随分类滚动，也不会被悬浮按钮遮挡 -->
        <view
          wx:if="{{isChef}}"
          class="rail-manage-bar"
          hover-class="rail-manage-press"
          bindtap="onOpenCategoryManager"
        >
          <text class="rail-manage-icon">⚙️</text>
          <text class="rail-manage-text">分类管理</text>
        </view>
      </view>

      <scroll-view
        class="dish-panel"
        scroll-y
        bindscrolltolower="onLoadMore"
        refresher-enabled="{{true}}"
        refresher-triggered="{{refreshing}}"
        bindrefresherrefresh="onRefresh"
        enable-back-to-top
      >
        <view class="dish-list">
          <!-- 首屏加载骨架：避免加载中闪现「暂无菜品」空状态 -->
          <block wx:if="{{loading && dishes.length === 0}}">
            <view class="skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
              <view class="skeleton-thumb skeleton-shimmer"></view>
              <view class="skeleton-lines">
                <view class="skeleton-line skeleton-shimmer"></view>
                <view class="skeleton-line skeleton-line-short skeleton-shimmer"></view>
              </view>
            </view>
          </block>
          <block wx:elif="{{dishes.length > 0}}">
            <dish-card
              wx:for="{{dishes}}"
              wx:key="dishId"
              dish="{{item}}"
              voters="{{item.voters}}"
              current-user-id="{{currentUserId}}"
              user-role="{{currentRole}}"
              bind:vote="onVote"
              bind:cancel="onCancel"
              bind:chefcancel="onChefCancel"
            />
          </block>
          <empty-state
            wx:else
            icon="🔍"
            title="该分类暂无菜品"
            description="试试其他分类吧"
          />

          <view class="panel-footer" wx:if="{{loading && dishes.length > 0}}">
            <text class="caption">加载中...</text>
          </view>
          <view class="panel-footer" wx:elif="{{!hasMore && dishes.length > 0}}">
            <text class="caption">没有更多了</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>

  <!-- 悬浮添加按钮（仅 chef） -->
  <view
    wx:if="{{hasFamily && isChef}}"
    class="fab"
    bindtap="onAddDish"
  >
    <text class="fab-icon">+</text>
  </view>

</view>

<!-- 隐私协议授权弹窗（PRIV-001） -->
<privacy-popup />
<!-- 一票否决原因选择（NOTIFY-002） -->
<reject-reason
  visible="{{showReject}}"
  dish-name="{{rejectDishName}}"
  bind:confirm="onRejectConfirm"
  bind:cancel="onRejectCancel"
/>

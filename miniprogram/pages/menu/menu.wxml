<!--pages/menu/menu.wxml-->
<view class="container menu-page {{themeClass}}">

  <!-- 顶部英雄区：主题签名色淡染，强化首屏视觉层级 -->
  <view class="menu-hero">
    <view class="header">
      <view class="header-left">
        <view class="header-title">筷点吃饭</view>
        <view class="header-sub">
          <text>{{dateText}}</text>
          <text wx:if="{{currentFamily}}" class="header-dot">·</text>
          <text wx:if="{{currentFamily}}" class="header-family">{{currentFamily.name}}</text>
        </view>
      </view>
      <view
        class="header-right"
        wx:if="{{currentFamily}}"
        catchtap="onFamilyTap"
      >
        <text class="switch-text">{{currentFamily.name}}</text>
        <text class="switch-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 家庭生日提醒（BIRTHDAY-001）：未来 7 天内有家人生日时出现。
       纯提示、不可点击——避免制造「点了没反应」的空交互 -->
  <view class="birthday-tip" wx:if="{{birthdayNotice}}">
    <text class="birthday-tip-emoji">🎂</text>
    <text class="birthday-tip-text">{{birthdayNotice}}</text>
  </view>

  <!-- 米饭引导：米饭已回归「主食」分类里的普通菜品（谁想吃谁点），
       这里只在主食里确实没有米饭时提示厨师补一道 -->
  <view
    class="rice-tip"
    wx:if="{{showRiceTip && !libraryEmpty}}"
    hover-class="rice-tip-press"
    bindtap="onCreateRiceDish"
  >
    <image class="rice-tip-icon" src="/images/category/cat-staple.svg" mode="aspectFit" />
    <text class="rice-tip-text">主食里还没有米饭，点这里加一道</text>
    <text class="rice-tip-arrow">›</text>
  </view>

  <!-- 今日推荐（RECOMMEND-001）已收进左侧导航首个「推荐」选项卡，
       推荐菜品用与点菜列表同一套 dish-card 渲染，排列与交互完全一致（见 menu-body） -->

  <!-- 无家庭 -->
  <block wx:if="{{!hasFamily}}">
    <empty-state
      icon="🏠"
      image="/images/empty/empty-family.svg"
      title="先加入家庭吧"
      description="创建或加入一个家庭后即可开始点菜"
    />
  </block>

  <block wx:elif="{{libraryEmpty}}">
    <!-- 菜品库为空 -->
    <empty-state
      wx:if="{{isChef}}"
      icon="🍳"
      image="/images/empty/empty-dishes.svg"
      title="还没有菜品"
      description="点击右下角添加菜品"
    />
    <empty-state
      wx:else
      icon="🍽️"
      image="/images/empty/empty-dishes.svg"
      title="金牌大厨还没添加菜品"
      description="耐心等待一下吧"
    />
  </block>

  <block wx:else>
    <!-- 主体：左侧分类导航（像 Word 的导航窗格）+ 右侧菜品列表，两侧各自独立滚动 -->
    <view class="menu-body">
      <view class="category-rail">
        <scroll-view
          class="rail-scroll"
          scroll-y
          scroll-into-view="{{railIntoView}}"
          scroll-with-animation
        >
          <view
            wx:for="{{categories}}"
            wx:key="key"
            id="rail-{{item.key}}"
            class="rail-item {{selectedCategory === item.key ? 'rail-item-active' : ''}}"
            data-key="{{item.key}}"
            bindtap="onCategoryTap"
          >
            <text class="rail-emoji">{{item.emoji}}</text>
            <text class="rail-name">{{item.name}}</text>
          </view>
          <view class="rail-pad"></view>
        </scroll-view>

        <!-- 分类管理入口固定在左栏底部（仅金牌大厨）：不随分类滚动，也不会被悬浮按钮遮挡 -->
        <view
          wx:if="{{isChef}}"
          class="rail-manage-bar"
          hover-class="rail-manage-press"
          bindtap="onOpenCategoryManager"
        >
          <text class="rail-manage-icon">⚙️</text>
          <text class="rail-manage-text">分类管理</text>
        </view>
      </view>

      <scroll-view
        class="dish-panel"
        scroll-y
        bindscrolltolower="onLoadMore"
        refresher-enabled="{{true}}"
        refresher-triggered="{{refreshing}}"
        bindrefresherrefresh="onRefresh"
        enable-back-to-top
      >
        <!-- 「推荐」选项卡：季节提示 + 与点菜列表完全一致的 dish-card 排列 -->
        <block wx:if="{{selectedCategory === 'recommend'}}">
          <view class="recommend-note">
            <view class="recommend-season" wx:if="{{recommend.seasonTip || recommend.noteText}}">
              <text class="recommend-season-emoji">{{seasonEmoji}}</text>
              <text class="recommend-season-text">{{recommend.noteText || recommend.seasonTip}}</text>
            </view>
            <!-- 天气 chip（WEATHER-002）：真机 IP 定位，无数据/失败时整行隐藏；直辖市时省略城市段 -->
            <view class="recommend-weather" wx:if="{{weather}}">
              <text class="recommend-weather-icon">{{weatherIcon}}</text>
              <text class="recommend-weather-text">{{weather.desc}}{{weather.temp !== null ? ' ' + weather.temp + '°C' : ''}}{{weather.city ? ' · ' + weather.city : ''}}</text>
            </view>
            <!-- 天气链路诊断（DIAG-001）：仅非正式版且天气缺失时出现，天气恢复即消失 -->
            <view class="recommend-weather-diag" wx:if="{{weatherDiagText}}">
              <text class="recommend-weather-diag-text">{{weatherDiagText}}</text>
            </view>
            <!-- 未到开启门槛：给进度而不是留白，让用户知道推荐会自己来 -->
            <view wx:if="{{!recommend.ready}}" class="recommend-progress">
              <text class="recommend-progress-text">{{recommend.progressText}}</text>
            </view>
          </view>

          <view class="dish-list">
            <dish-card
              wx:for="{{recommendDishes}}"
              wx:key="dishId"
              id="rec-card-{{index}}"
              dish="{{item.dish}}"
              voters="{{item.voters}}"
              reason-text="{{item.reasonText}}"
              current-user-id="{{currentUserId}}"
              user-role="{{currentRole}}"
              bind:vote="onVote"
              bind:cancel="onCancel"
              bind:chefcancel="onChefCancel"
            />
            <empty-state
              wx:if="{{recommendDishes.length === 0 && recommend.ready}}"
              icon="🍳"
              title="今天还没有推荐"
              description="多攒几天点菜记录就有啦"
            />
          </view>
        </block>

        <view class="dish-list" wx:else>
          <!-- 首屏加载骨架：避免加载中闪现「暂无菜品」空状态 -->
          <block wx:if="{{loading && dishes.length === 0}}">
            <view class="skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
              <view class="skeleton-thumb skeleton-shimmer"></view>
              <view class="skeleton-lines">
                <view class="skeleton-line skeleton-shimmer"></view>
                <view class="skeleton-line skeleton-line-short skeleton-shimmer"></view>
              </view>
            </view>
          </block>
          <block wx:elif="{{dishes.length > 0}}">
            <dish-card
              wx:for="{{dishes}}"
              wx:key="dishId"
              dish="{{item}}"
              voters="{{item.voters}}"
              current-user-id="{{currentUserId}}"
              user-role="{{currentRole}}"
              bind:vote="onVote"
              bind:cancel="onCancel"
              bind:chefcancel="onChefCancel"
            />
          </block>
          <empty-state
            wx:else
            icon="🔍"
            title="该分类暂无菜品"
            description="试试其他分类吧"
          />

          <view class="panel-footer" wx:if="{{loading && dishes.length > 0}}">
            <text class="caption">加载中...</text>
          </view>
          <view class="panel-footer" wx:elif="{{!hasMore && dishes.length > 0}}">
            <text class="caption">没有更多了</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>

  <!-- 悬浮添加按钮（仅 chef） -->
  <view
    wx:if="{{hasFamily && isChef}}"
    class="fab"
    bindtap="onAddDish"
  >
    <text class="fab-icon">+</text>
  </view>

</view>

<!-- 隐私协议授权弹窗（PRIV-001） -->
<privacy-popup />
<!-- 一票否决原因选择（NOTIFY-002） -->
<reject-reason
  visible="{{showReject}}"
  dish-name="{{rejectDishName}}"
  bind:confirm="onRejectConfirm"
  bind:cancel="onRejectCancel"
/>
<!-- 生日当天公告弹窗（BIRTHDAY-003）：一天只弹一次；寿星与家人看到的是两套文案。
     id 供自动化测试用 selectComponent 验证事件链路（组件内部节点页面级 selector 查不到） -->
<birthday-popup
  id="birthday-popup"
  visible="{{!!birthdayPopup}}"
  title="{{birthdayPopup.title}}"
  body="{{birthdayPopup.body}}"
  blessing="{{birthdayPopup.blessing}}"
  bind:close="onCloseBirthdayPopup"
/>

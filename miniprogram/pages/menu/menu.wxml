<!--pages/menu/menu.wxml-->
<view class="container menu-page {{themeClass}}">

  <!-- 顶部区域 -->
  <view class="header">
    <view class="header-left">
      <view class="header-title">筷点吃饭</view>
      <view class="header-sub">
        <text>{{dateText}}</text>
        <text wx:if="{{currentFamily}}" class="header-dot">·</text>
        <text wx:if="{{currentFamily}}" class="header-family">{{currentFamily.name}}</text>
      </view>
    </view>
    <view
      class="header-right"
      wx:if="{{currentFamily}}"
      catchtap="onFamilyTap"
    >
      <text class="switch-text">{{currentFamily.name}}</text>
      <text class="switch-arrow">›</text>
    </view>
  </view>

  <!-- 今日米饭（RICE-001）：全员饭量上报，掌勺一眼看总碗数 -->
  <view class="rice-card" wx:if="{{hasFamily}}">
    <view class="rice-head">
      <text class="rice-title">今日米饭</text>
      <text class="rice-total {{rice.hasReport ? '' : 'rice-total-empty'}}">{{rice.totalText}}</text>
    </view>
    <view class="rice-mine">
      <text class="rice-mine-label">我的</text>
      <view class="rice-stepper">
        <view class="rice-step-btn" hover-class="rice-step-press" data-delta="-0.5" bindtap="onRiceStep">－</view>
        <text class="rice-mine-num">{{rice.mineText}}</text>
        <view class="rice-step-btn" hover-class="rice-step-press" data-delta="0.5" bindtap="onRiceStep">＋</view>
      </view>
    </view>
    <view class="rice-others" wx:if="{{rice.othersText}}">{{rice.othersText}}</view>
    <view class="rice-unreported" wx:if="{{rice.unreportedCount > 0}}">还有 {{rice.unreportedCount}} 人没报</view>
  </view>

  <!-- 无家庭 -->
  <block wx:if="{{!hasFamily}}">
    <empty-state
      icon="🏠"
      image="/images/empty/empty-family.svg"
      title="先加入家庭吧"
      description="创建或加入一个家庭后即可开始点菜"
    />
  </block>

  <block wx:elif="{{libraryEmpty}}">
    <!-- 菜品库为空 -->
    <empty-state
      wx:if="{{isChef}}"
      icon="🍳"
      image="/images/empty/empty-dishes.svg"
      title="还没有菜品"
      description="点击右下角添加菜品"
    />
    <empty-state
      wx:else
      icon="🍽️"
      image="/images/empty/empty-dishes.svg"
      title="掌勺的还没添加菜品"
      description="耐心等待一下吧"
    />
  </block>

  <block wx:else>
    <!-- 统计栏 -->
    <view class="stats-bar">
      <text class="stats-text">已点 <text class="stats-num">{{stats.dishCount}}</text> 道菜</text>
      <text class="stats-dot">·</text>
      <text class="stats-text"><text class="stats-num">{{stats.voterCount}}</text> 人参与</text>
    </view>
    <text wx:if="{{isChef}}" class="chef-hint">长按菜品卡片可撤下这道菜</text>

    <!-- 分类筛选 -->
    <scroll-view class="category-scroll" scroll-x>
      <view class="category-list">
        <view
          wx:for="{{categories}}"
          wx:key="key"
          class="category-item {{selectedCategory === item.key ? 'category-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onCategoryTap"
        >
          <text class="category-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 菜品列表 -->
    <view class="dish-list safe-bottom">
      <!-- 首屏加载骨架：避免加载中闪现「暂无菜品」空状态 -->
      <block wx:if="{{loading && dishes.length === 0}}">
        <view class="skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
          <view class="skeleton-thumb skeleton-shimmer"></view>
          <view class="skeleton-lines">
            <view class="skeleton-line skeleton-shimmer"></view>
            <view class="skeleton-line skeleton-line-short skeleton-shimmer"></view>
          </view>
        </view>
      </block>
      <block wx:elif="{{dishes.length > 0}}">
        <dish-card
          wx:for="{{dishes}}"
          wx:key="dishId"
          dish="{{item}}"
          voters="{{item.voters}}"
          current-user-id="{{currentUserId}}"
          user-role="{{currentRole}}"
          bind:vote="onVote"
          bind:cancel="onCancel"
          bind:chefcancel="onChefCancel"
        />
      </block>
      <empty-state
        wx:else
        icon="🔍"
        title="该分类暂无菜品"
        description="试试其他分类吧"
      />
    </view>
  </block>

  <!-- 悬浮添加按钮（仅 chef） -->
  <view
    wx:if="{{hasFamily && isChef}}"
    class="fab"
    bindtap="onAddDish"
  >
    <text class="fab-icon">+</text>
  </view>

</view>

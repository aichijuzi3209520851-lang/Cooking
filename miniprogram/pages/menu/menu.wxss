/* pages/menu/menu.wxss
 * 布局原则：
 *   - 页边距 32rpx（--space-4），卡片内边距 32rpx，卡片间距 24rpx
 *   - 区块之间用「卡片 → 淡染条 → 胶囊 → 卡片」交替，避免一片白导致层级塌陷
 */
.menu-page {
  padding-top: 0;
  padding-bottom: var(--space-6);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 英雄区：主题签名色淡染，负边距做全出血 ===== */
.menu-hero {
  margin: 0 calc(var(--space-4) * -1) var(--space-4);
  padding: var(--space-3) var(--space-4) var(--space-4);
  background: linear-gradient(160deg, var(--tint-1) 0%, var(--tint-2) 55%, var(--tint-3) 100%);
  border-bottom-left-radius: var(--radius-xl);
  border-bottom-right-radius: var(--radius-xl);
}

/* ===== 顶部标题区 ===== */
.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-2);
}

.header-left {
  flex: 1;
  min-width: 0;
}

.header-title {
  font-size: var(--text-h1);
  font-weight: var(--weight-black);
  color: var(--color-text-primary);
  letter-spacing: -0.5rpx;
  line-height: var(--lh-tight);
}

.header-sub {
  display: flex;
  align-items: center;
  margin-top: var(--space-2);
  font-size: var(--text-caption);
  color: var(--color-text-secondary);
  line-height: var(--lh-normal);
}

.header-dot {
  margin: 0 var(--space-1);
  color: var(--color-text-tertiary);
}

.header-family {
  color: var(--color-text-secondary);
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 家庭切换胶囊：与标题基线对齐，不抢主标题视觉 */
.header-right {
  display: flex;
  align-items: center;
  padding: var(--space-1) var(--space-3);
  margin-top: 10rpx;
  border-radius: var(--radius-pill);
  background: var(--surface-card);
  box-shadow: var(--elev-1);
  flex-shrink: 0;
  max-width: 300rpx;
  transition: transform var(--dur-fast) var(--ease-out);
}

.header-right:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.switch-text {
  font-size: var(--text-caption);
  color: var(--color-text-primary);
  font-weight: var(--weight-semibold);
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.switch-arrow {
  font-size: 34rpx;
  color: var(--color-text-tertiary);
  margin-left: 2rpx;
  line-height: 1;
}

/* ===== 今日米饭（RICE-001）
   白卡片 + 米黄凹陷行，与下方的纯白菜品卡形成「信息块 vs 列表项」区分 ===== */
.rice-card {
  padding: var(--space-4);
  margin-bottom: var(--space-3);
  border-radius: var(--radius-lg);
  background: var(--surface-card);
  box-shadow: var(--elev-1);
  box-sizing: border-box;
}

.rice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rice-title {
  font-size: var(--text-body);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.rice-total {
  font-size: var(--text-caption);
  font-weight: var(--weight-semibold);
  color: var(--color-num-strong);
}

.rice-total-empty {
  font-weight: var(--weight-medium);
  color: var(--color-text-tertiary);
}

/* 我的饭量：米黄凹陷行收纳步进器 */
.rice-mine {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
  background: var(--color-cream);
}

.rice-mine-label {
  font-size: var(--text-caption);
  color: var(--color-text-secondary);
}

.rice-stepper {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.rice-step-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--surface-card);
  border: 1rpx solid var(--color-border);
  color: var(--color-text-primary);
  font-size: 34rpx;
  transition: transform var(--dur-fast) var(--ease-out);
}

.rice-step-btn:active {
  transform: scale(0.92);
}

.rice-step-press {
  opacity: 0.6;
}

.rice-mine-num {
  display: inline-block;
  min-width: 120rpx;
  text-align: center;
  font-size: var(--text-h3);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.rice-others {
  margin-top: var(--space-3);
  font-size: var(--text-caption);
  line-height: var(--lh-loose);
  color: var(--color-text-secondary);
}

.rice-unreported {
  margin-top: var(--space-1);
  font-size: var(--text-mini);
  color: var(--color-text-tertiary);
}

/* ===== 统计条：极淡主题染条，不做卡片，避免与菜品卡同质化 ===== */
.stats-bar {
  display: flex;
  align-items: center;
  padding: var(--space-2) var(--space-4);
  margin-bottom: var(--space-3);
  border-radius: var(--radius-md);
  background: var(--color-accent-wash);
}

.stats-text {
  font-size: var(--text-caption);
  color: var(--color-text-secondary);
}

.stats-num {
  font-size: var(--text-h3);
  font-weight: var(--weight-black);
  color: var(--color-num-strong);
  padding: 0 6rpx;
}

.stats-dot {
  margin: 0 var(--space-3);
  color: var(--color-text-tertiary);
  font-size: var(--text-caption);
}

/* chef 长按撤下提示 */
.chef-hint {
  display: block;
  font-size: var(--text-mini);
  color: var(--color-text-tertiary);
  text-align: center;
  margin: calc(var(--space-2) * -1) 0 var(--space-3);
}

/* ===== 分类筛选（胶囊） ===== */
.category-scroll {
  white-space: nowrap;
  margin: 0 calc(var(--space-4) * -1);
  padding: 0 var(--space-4);
  margin-bottom: var(--space-4);
  /* 两端渐隐，提示右侧还有更多分类 */
  -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 24rpx, #000 calc(100% - 24rpx), transparent 100%);
}

.category-list {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding-bottom: var(--space-1);
}

.category-item {
  display: inline-flex;
  align-items: center;
  padding: 14rpx var(--space-4);
  border-radius: var(--radius-pill);
  background: var(--surface-card);
  box-shadow: var(--elev-1);
  transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
}

.category-item:active {
  opacity: 0.7;
  transform: scale(0.96);
}

.category-name {
  font-size: var(--text-body-sm);
  color: var(--color-text-secondary);
  font-weight: var(--weight-medium);
  line-height: 1.3;
}

.category-active {
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  box-shadow: var(--elev-accent);
}

.category-active .category-name {
  color: var(--color-on-accent);
  font-weight: var(--weight-semibold);
}

/* ===== 菜品列表 ===== */
.dish-list {
  padding-top: var(--space-1);
}

/* ===== 首屏加载骨架（形状与 dish-card 对齐，避免加载完成时跳动） ===== */
.skeleton-card {
  display: flex;
  align-items: center;
  background: var(--surface-card);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
  box-shadow: var(--elev-1);
  box-sizing: border-box;
}

.skeleton-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-md);
  background: var(--surface-sunken);
  margin-right: var(--space-3);
  flex-shrink: 0;
}

.skeleton-lines {
  flex: 1;
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-xs);
  background: var(--surface-sunken);
  margin-bottom: var(--space-2);
}

.skeleton-line-short {
  width: 40%;
  margin-bottom: 0;
}

.skeleton-shimmer {
  animation: skeleton-pulse 1.2s ease-in-out infinite;
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}


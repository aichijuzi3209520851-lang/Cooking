/* pages/menu/menu.wxss */
.menu-page {
  padding-top: 24rpx;
  padding-bottom: 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 顶部区域 ===== */
.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 8rpx 28rpx;
}

.header-left {
  flex: 1;
  min-width: 0;
}

.header-title {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--color-text-primary);
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}

.header-sub {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.header-dot {
  margin: 0 10rpx;
  color: var(--color-text-tertiary);
}

.header-family {
  color: var(--color-text-secondary);
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-right {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  margin-top: 8rpx;
  margin-left: 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-accent-soft);
  flex-shrink: 0;
  max-width: 320rpx;
}

.switch-text {
  font-size: 26rpx;
  color: var(--color-accent-deep);
  font-weight: 600;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.switch-arrow {
  font-size: 34rpx;
  color: var(--color-accent-deep);
  margin-left: 2rpx;
  line-height: 1;
}

/* ===== 今日米饭（RICE-001） ===== */
.rice-card {
  padding: 22rpx 32rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-lg);
  background: var(--color-cream);
  border: 1rpx solid rgba(230, 162, 60, 0.18);
}

.rice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.rice-total {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-num-strong);
}

.rice-total-empty {
  font-weight: 400;
  color: var(--color-text-tertiary);
}

.rice-mine {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.rice-mine-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.rice-stepper {
  display: flex;
  align-items: center;
}

.rice-step-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  color: var(--color-text-primary);
  font-size: 34rpx;
}

.rice-step-press {
  opacity: 0.6;
}

.rice-mine-num {
  display: inline-block;
  min-width: 128rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.rice-others {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.rice-unreported {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* ===== 统计栏（暖色横幅） ===== */
.stats-bar {
  display: flex;
  align-items: center;
  padding: 22rpx 32rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-lg);
  background: var(--color-cream);
  border: 1rpx solid rgba(230, 162, 60, 0.18);
}

/* chef 长按撤下提示 */
.chef-hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  text-align: center;
  margin: -12rpx 0 12rpx;
}

.stats-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.stats-num {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-num-strong);
  padding: 0 4rpx;
}

.stats-dot {
  margin: 0 16rpx;
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}

/* ===== 分类筛选（填充式胶囊） ===== */
.category-scroll {
  white-space: nowrap;
  margin: 0 -32rpx;
  padding: 0 32rpx;
  margin-bottom: 28rpx;
  /* 两端渐隐，提示右侧还有更多分类 */
  -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 24rpx, #000 calc(100% - 24rpx), transparent 100%);
}

.category-list {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 32rpx;
  border-radius: var(--radius-pill);
  background: var(--color-card);
  box-shadow: var(--shadow-card);
  transition: all 0.2s ease;
}

.category-item:active {
  opacity: 0.7;
}

.category-name {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  line-height: 1.3;
}

.category-active {
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  box-shadow: var(--shadow-accent);
}

.category-active .category-name {
  color: var(--color-on-accent);
  font-weight: 600;
}

/* ===== 菜品列表 ===== */
.dish-list {
  padding-top: 8rpx;
}

/* ===== 首屏加载骨架 ===== */
.skeleton-card {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.skeleton-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 22rpx;
  background: var(--color-bg-tertiary);
  margin-right: 24rpx;
  flex-shrink: 0;
}

.skeleton-lines {
  flex: 1;
}

.skeleton-line {
  height: 32rpx;
  border-radius: 8rpx;
  background: var(--color-bg-tertiary);
  margin-bottom: 16rpx;
}

.skeleton-line-short {
  width: 40%;
  margin-bottom: 0;
}

.skeleton-shimmer {
  animation: skeleton-pulse 1.2s ease-in-out infinite;
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

/* ===== 悬浮按钮 ===== */

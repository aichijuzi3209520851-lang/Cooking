/* pages/menu/menu.wxss */
.menu-page {
  padding-top: 24rpx;
  padding-bottom: 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 顶部区域 ===== */
.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 8rpx 28rpx;
}

.header-left {
  flex: 1;
  min-width: 0;
}

.header-title {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--color-text-primary);
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}

.header-sub {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.header-dot {
  margin: 0 10rpx;
  color: var(--color-text-tertiary);
}

.header-family {
  color: var(--color-text-secondary);
}

.header-right {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  margin-top: 8rpx;
  border-radius: var(--radius-pill);
  background: var(--color-accent-soft);
  flex-shrink: 0;
}

.switch-text {
  font-size: 26rpx;
  color: var(--color-accent);
  font-weight: 600;
}

.switch-arrow {
  font-size: 34rpx;
  color: var(--color-accent);
  margin-left: 2rpx;
  line-height: 1;
}

/* ===== 统计栏（暖色横幅） ===== */
.stats-bar {
  display: flex;
  align-items: center;
  padding: 22rpx 32rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-lg);
  background: var(--color-cream);
  border: 1rpx solid rgba(230, 162, 60, 0.18);
}

/* chef 长按撤下提示 */
.chef-hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  text-align: center;
  margin: -12rpx 0 12rpx;
}

.stats-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.stats-num {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-accent);
  padding: 0 4rpx;
}

.stats-dot {
  margin: 0 16rpx;
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}

/* ===== 分类筛选（填充式胶囊） ===== */
.category-scroll {
  white-space: nowrap;
  margin: 0 -32rpx;
  padding: 0 32rpx;
  margin-bottom: 28rpx;
}

.category-list {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 32rpx;
  border-radius: var(--radius-pill);
  background: var(--color-card);
  box-shadow: var(--shadow-card);
  transition: all 0.2s ease;
}

.category-item:active {
  opacity: 0.7;
}

.category-name {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  line-height: 1.3;
}

.category-active {
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  box-shadow: var(--shadow-accent);
}

.category-active .category-name {
  color: #FFFFFF;
  font-weight: 600;
}

.category-underline {
  display: none;
}

/* ===== 菜品列表 ===== */
.dish-list {
  padding-top: 8rpx;
}

/* ===== 悬浮按钮 ===== */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-accent);
  z-index: 100;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.fab:active {
  transform: scale(0.92);
  opacity: 0.9;
}

.fab-icon {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

/* pages/menu/menu.wxss
 * 布局原则：
 *   - 页边距 32rpx（--space-4），卡片内边距 32rpx，卡片间距 24rpx
 *   - 区块之间用「卡片 → 淡染条 → 胶囊 → 卡片」交替，避免一片白导致层级塌陷
 *
 * 结构（自上而下，页面整体定高不滚动）：
 *   hero（签名色淡染） → 米饭引导条（按需） → [ 左分类导航 | 右菜品列表 ]
 *   左侧导航首项是「推荐」伪分类，点开后右侧切换为今日推荐（复用同一套 dish-card），
 *   其余「全部 / 荤菜 / 素菜…」渲染菜品列表；上半部只有 hero 一层，纵向空间都给菜品。
 *   上半部按内容自然排布且不可压缩（flex-shrink:0），
 *   .menu-body 用 flex:1 吃掉剩余高度，内部左右两栏各自 scroll-view 独立滚动
 *   —— 即 Word「导航窗格」式布局：左栏固定可见，右栏单独滚动。
 */

.menu-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-top: 0;
  padding-bottom: 0;
  box-sizing: border-box;
  overflow: hidden;
}

/* ===== 英雄区：主题签名色淡染，负边距做全出血 =====
   上半部整体是「配角」，竖向预算能省则省——每 1rpx 都是从菜品列表可视区里扣的 */
.menu-hero {
  flex-shrink: 0;
  margin: 0 calc(var(--space-4) * -1) var(--space-3);
  padding: var(--space-2) var(--space-4) var(--space-3);
  background: linear-gradient(160deg, var(--tint-1) 0%, var(--tint-2) 55%, var(--tint-3) 100%);
  border-bottom-left-radius: var(--radius-xl);
  border-bottom-right-radius: var(--radius-xl);
}

/* ===== 顶部标题区 ===== */
.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-2);
}

.header-left {
  flex: 1;
  min-width: 0;
}

/* 品牌主标题用 h1 档（52rpx/800）：曾经是 display(68)，但 hero 只是「签名」，
   真正的主角是下面的菜品列表——首屏高度有限，标题降一档、菜品多露一张卡 */
.header-title {
  font-size: var(--text-h1);
  font-weight: var(--weight-black);
  color: var(--color-text-primary);
  letter-spacing: -1rpx;
  line-height: var(--lh-tight);
}

.header-sub {
  display: flex;
  align-items: center;
  margin-top: var(--space-1);
  font-size: var(--text-body-sm);
  color: var(--color-text-secondary);
  line-height: var(--lh-normal);
}

.header-dot {
  margin: 0 var(--space-1);
  color: var(--color-text-tertiary);
}

.header-family {
  color: var(--color-text-secondary);
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 家庭切换胶囊：与标题基线对齐，不抢主标题视觉 */
.header-right {
  display: flex;
  align-items: center;
  padding: var(--space-1) var(--space-3);
  margin-top: 10rpx;
  border-radius: var(--radius-pill);
  background: var(--surface-card);
  box-shadow: var(--elev-1);
  flex-shrink: 0;
  max-width: 300rpx;
  transition: transform var(--dur-fast) var(--ease-out);
}

.header-right:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.switch-text {
  font-size: var(--text-body-sm);
  color: var(--color-text-primary);
  font-weight: var(--weight-semibold);
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.switch-arrow {
  font-size: var(--text-h3);
  color: var(--color-text-tertiary);
  margin-left: 2rpx;
  line-height: 1;
}

/* ===== 米饭引导条（原「今日米饭」日报卡下线后的一次性引导）
   极淡一条，不抢推荐与菜品列表的注意力 ===== */
.rice-tip {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-3);
  border-radius: var(--radius-md);
  background: var(--color-cream);
  border: 1rpx solid var(--color-border);
  box-sizing: border-box;
  transition: opacity var(--dur-fast) var(--ease-out);
}

/* 家庭生日提醒条（BIRTHDAY-001）：用强调色淡染区别于米黄的米饭引导条，
   传达「喜事」语义；纯提示不可点，所以没有 press 态 */
.birthday-tip {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-3);
  border-radius: var(--radius-md);
  background: var(--color-accent-wash);
  border: 1rpx solid var(--color-accent-soft);
  box-sizing: border-box;
}

.birthday-tip-emoji {
  font-size: var(--text-h2);
  line-height: 1;
  margin-right: var(--space-3);
  flex-shrink: 0;
}

.birthday-tip-text {
  flex: 1;
  min-width: 0;
  font-size: var(--text-body-sm);
  font-weight: var(--weight-medium);
  color: var(--color-accent-deep);
  line-height: var(--lh-normal);
}

.rice-tip-press {
  opacity: 0.75;
}

/* 用主食分类插画（红碗白米饭 + 热气）而非 emoji：小尺寸下更清晰，
   也与「加进主食分类」后菜品占位图同款，前后视觉一致 */
.rice-tip-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: var(--space-3);
  flex-shrink: 0;
  display: block;
}

.rice-tip-text {
  flex: 1;
  min-width: 0;
  font-size: var(--text-body-sm);
  color: var(--color-text-secondary);
  line-height: var(--lh-normal);
}

.rice-tip-arrow {
  font-size: var(--text-h3);
  color: var(--color-text-tertiary);
  line-height: 1;
  flex-shrink: 0;
}

/* ===== 今日推荐（RECOMMEND-001）
   已从页面上半部收进左侧导航首个「推荐」选项卡；
   这里是推荐视图顶部的说明区：季节一行 + 未到门槛时的进度条 ===== */
.recommend-note {
  padding: var(--space-2) var(--space-4) var(--space-3);
}

/* 季节气候：独立成行 + 强调色 + 中等字重（原为标题右侧 22rpx 三级灰，
   真机上约 11pt，是 iOS 最小可读档，用来承载「秋凉渐起，晚上来碗热汤」
   这种有说服力的文案是错的） */
.recommend-season {
  display: flex;
  align-items: flex-start;
  margin-top: var(--space-1);
}

.recommend-season-emoji {
  font-size: var(--text-season);
  line-height: var(--lh-normal);
  margin-right: var(--space-1);
  flex-shrink: 0;
}

.recommend-season-text {
  flex: 1;
  min-width: 0;
  font-size: var(--text-season);
  font-weight: var(--weight-medium);
  color: var(--color-accent-deep);
  line-height: var(--lh-normal);
}

.recommend-progress {
  margin-top: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
  background: var(--color-cream);
}

.recommend-progress-text {
  font-size: var(--text-body-sm);
  color: var(--color-text-secondary);
  line-height: var(--lh-normal);
}

/* 天气 chip（WEATHER-002）：季节文案下方一行小字，无数据时整行隐藏不占位 */
.recommend-weather {
  display: flex;
  align-items: center;
  margin-top: var(--space-1);
}

.recommend-weather-icon {
  font-size: var(--text-season);
  line-height: var(--lh-normal);
  margin-right: var(--space-1);
  flex-shrink: 0;
}

.recommend-weather-text {
  font-size: var(--text-caption);
  color: var(--color-text-tertiary);
  line-height: var(--lh-normal);
}

/* 天气链路诊断（DIAG-001）：只出现在开发/体验版且天气缺失时，字小、颜色弱，不抢视觉 */
.recommend-weather-diag {
  margin-top: var(--space-1);
}

.recommend-weather-diag-text {
  font-size: var(--text-caption);
  color: var(--color-text-tertiary);
  line-height: var(--lh-normal);
  opacity: 0.8;
}

/* ============================================================
 * 主体：左分类导航 + 右菜品列表（导航窗格式布局）
 * 两栏各自独立滚动，互不带动；左栏贴屏幕左缘，右栏内容自带页边距
 * ============================================================ */
.menu-body {
  flex: 1;
  min-height: 0;
  display: flex;
  /* 全出血：让左栏贴住屏幕左缘（抵消 .container 的左右内边距） */
  margin: 0 calc(var(--space-4) * -1);
}

/* ---- 左侧分类导航（导航窗格） ---- */
/* 竖排 flex：分类列表可滚动，管理入口固定在底部（不随分类滚走、不被悬浮按钮遮挡）
   宽度刻意收窄（128rpx）：导航是配角，宽度每多 1rpx 都是从菜品信息区里扣的 ——
   390px 屏下左栏 + 缩略图 + 投票按钮是刚性占用，剩余宽度才是菜名的活路 */
.category-rail {
  width: 128rpx;
  height: 100%;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  background: var(--surface-sunken);
  border-top-right-radius: var(--radius-md);
  box-sizing: border-box;
}

.rail-scroll {
  flex: 1;
  min-height: 0;
}

.rail-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 112rpx;
  padding: var(--space-2) var(--space-1);
  box-sizing: border-box;
  transition: background var(--dur-fast) var(--ease-out);
}

.rail-item:active {
  background: var(--surface-card);
}

.rail-emoji {
  font-size: 32rpx;
  line-height: 1;
  margin-bottom: var(--space-1);
  opacity: 0.7;
}

/* 未选中 400 / 选中 700 —— 选中态靠字重跳档而非加色块，
   避免左右两栏同时用底色抢注意力 */
.rail-name {
  font-size: var(--text-caption);
  color: var(--color-text-secondary);
  line-height: 1.25;
  text-align: center;
  word-break: break-all;
}

/* 选中态：白底浮起 + 左缘强调竖条（对应 Word 导航窗格的「当前章节」） */
.rail-item-active {
  background: var(--surface-card);
  box-shadow: var(--elev-1);
}

.rail-item-active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 48rpx;
  border-radius: 0 var(--radius-pill) var(--radius-pill) 0;
  background: var(--color-accent);
}

.rail-item-active .rail-emoji {
  opacity: 1;
}

.rail-item-active .rail-name {
  color: var(--color-accent-deep);
  font-weight: var(--weight-bold);
}

/* 分类管理入口：固定在左栏底部，弱化处理不与分类争夺注意力 */
.rail-manage-bar {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-2) 0;
  border-top: 1rpx solid var(--hairline);
  background: var(--surface-card);
  transition: opacity var(--dur-fast) var(--ease-out);
}

.rail-manage-press {
  opacity: 0.7;
}

.rail-manage-icon {
  font-size: 30rpx;
  line-height: 1;
  opacity: 0.6;
}

.rail-manage-text {
  margin-top: var(--space-1);
  font-size: var(--text-caption);
  color: var(--color-text-tertiary);
  line-height: 1.2;
}

.rail-pad {
  height: var(--space-4);
}

/* ---- 右侧菜品列表 ---- */
.dish-panel {
  flex: 1;
  min-width: 0;
  height: 100%;
}

.dish-list {
  padding: var(--space-1) var(--space-4) calc(env(safe-area-inset-bottom) + 180rpx);
}

.panel-footer {
  padding: var(--space-4) 0;
  text-align: center;
}

/* ===== 首屏加载骨架（形状与 dish-card 对齐，避免加载完成时跳动） ===== */
.skeleton-card {
  display: flex;
  align-items: center;
  background: var(--surface-card);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  /* 与 dish-card 的 margin-bottom 保持一致，加载完成时列表不跳动 */
  margin-bottom: var(--space-4);
  box-shadow: var(--elev-1);
  box-sizing: border-box;
}

.skeleton-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-md);
  background: var(--surface-sunken);
  margin-right: var(--space-3);
  flex-shrink: 0;
}

.skeleton-lines {
  flex: 1;
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-xs);
  background: var(--surface-sunken);
  margin-bottom: var(--space-2);
}

.skeleton-line-short {
  width: 40%;
  margin-bottom: 0;
}

.skeleton-shimmer {
  animation: skeleton-pulse 1.2s ease-in-out infinite;
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

/* ===== 悬浮按钮 ===== */
/* .fab 已提升为 app.wxss 全局类（自动避让 tabBar 与底部安全区），此处不再重复定义 */

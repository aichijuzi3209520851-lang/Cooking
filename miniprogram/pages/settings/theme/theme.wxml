<!--pages/settings/theme/theme.wxml-->
<view class="container theme-page {{themeClass}}">
  <!-- 外观主题：4 张色卡，所见即所得 -->
  <view class="section">
    <view class="section-title">外观主题</view>
    <view class="theme-grid">
      <view
        class="theme-card {{themeFamily === item.key ? 'theme-card-active' : ''}}"
        wx:for="{{familyOptions}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onSelectFamily"
      >
        <view class="pv pv-{{item.key}}">
          <!-- 跟随系统：暖调/夜间对半预览 -->
          <block wx:if="{{item.key === 'system'}}">
            <view class="pv-half pv-half-warm">
              <view class="pv-btn pv-btn-warm"></view>
            </view>
            <view class="pv-half pv-half-dark">
              <view class="pv-btn pv-btn-dark"></view>
            </view>
          </block>
          <block wx:else>
            <view class="pv-line pv-title"></view>
            <view class="pv-btn"></view>
            <view class="pv-line pv-short"></view>
          </block>
          <view class="theme-card-check" wx:if="{{themeFamily === item.key}}">✓</view>
        </view>
        <view class="theme-card-name">{{item.name}}</view>
        <view class="theme-card-sub" wx:if="{{item.key === 'system'}}">当前：{{resolvedFamilyName}}</view>
      </view>
    </view>
  </view>

  <view class="preview-tip">
    <text class="caption">设置立即生效，所有页面同步切换</text>
  </view>
</view>

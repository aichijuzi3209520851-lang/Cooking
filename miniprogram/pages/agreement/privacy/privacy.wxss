/* pages/agreement/privacy/privacy.wxss */
.privacy-page {
  padding: var(--spacing-md) var(--spacing-md) var(--spacing-xl);
}

.privacy-card {
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
}

.privacy-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.privacy-date {
  margin-top: var(--spacing-xs);
  color: var(--color-text-tertiary);
}

.privacy-lead {
  margin-top: var(--spacing-md);
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--color-text-secondary);
}

.privacy-h {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.5;
  margin-bottom: var(--spacing-sm);
}

.privacy-item {
  margin-bottom: var(--spacing-md);
}

.privacy-item:last-child {
  margin-bottom: 0;
}

.privacy-item-t {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-accent-deep);
  line-height: 1.6;
  margin-bottom: 6rpx;
}

.privacy-p {
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--color-text-secondary);
}

.privacy-footer {
  padding: var(--spacing-sm) var(--spacing-sm) var(--spacing-lg);
  text-align: center;
  color: var(--color-text-tertiary);
  line-height: 1.7;
}

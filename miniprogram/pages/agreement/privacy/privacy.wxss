/* pages/agreement/privacy/privacy.wxss
 * 长文排版：章节标题 h3（38）与正文 body-sm（26）拉开可扫读的层级差，
 * 行高统一走 --lh-* 令牌，间距全部 --space-*（旧 --spacing-* 别名已迁移）
 */
.privacy-page {
  padding: var(--space-3) var(--space-3) var(--space-8);
}

.privacy-card {
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}

.privacy-title {
  font-size: var(--text-h2);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
}

.privacy-date {
  margin-top: var(--space-1);
  color: var(--color-text-tertiary);
}

.privacy-lead {
  margin-top: var(--space-3);
  font-size: var(--text-body-sm);
  line-height: var(--lh-loose);
  color: var(--color-text-secondary);
}

.privacy-h {
  font-size: var(--text-h3);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
  margin-bottom: var(--space-2);
}

.privacy-item {
  margin-bottom: var(--space-3);
}

.privacy-item:last-child {
  margin-bottom: 0;
}

.privacy-item-t {
  font-size: var(--text-body-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-accent-deep);
  line-height: var(--lh-loose);
  margin-bottom: var(--space-1);
}

.privacy-p {
  font-size: var(--text-body-sm);
  line-height: 1.8;
  color: var(--color-text-secondary);
}

/* 需要用户注意的关键词（权限名、存储期限、撤回同意等） */
.privacy-strong {
  font-weight: var(--weight-medium);
  color: var(--color-text-primary);
}

/* 补充说明块：用于解释隐私接口被拦截等平台机制 */
.privacy-note {
  margin-top: var(--space-2);
  padding: var(--space-2);
  font-size: var(--text-caption);
  line-height: var(--lh-loose);
  color: var(--color-text-tertiary);
  background: var(--surface-sunken);
  border-radius: var(--radius-sm);
}

.privacy-footer {
  padding: var(--space-2) var(--space-2) var(--space-4);
  text-align: center;
  color: var(--color-text-tertiary);
  line-height: var(--lh-loose);
}

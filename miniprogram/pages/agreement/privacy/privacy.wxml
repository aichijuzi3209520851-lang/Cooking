<!--pages/agreement/privacy/privacy.wxml-->
<!--内容来自 utils/privacy-content.js（内置兜底）或云端 app_config 实时下发，结构由 normalizePrivacyDoc 保证-->
<view class="container privacy-page {{themeClass}}">

  <view class="card privacy-card">
    <view class="privacy-title">{{doc.title}}</view>
    <view class="caption privacy-date">更新日期：{{dateText}}</view>
    <view wx:for="{{doc.lead}}" wx:key="_k" class="privacy-lead">{{item.text}}</view>
  </view>

  <view wx:for="{{doc.sections}}" wx:key="_k" class="card privacy-card">
    <view class="privacy-h">{{item.heading}}</view>

    <block wx:for="{{item.blocks}}" wx:for-item="block" wx:key="_k">

      <!-- 带小标题的条目 -->
      <view wx:if="{{block.t === 'item'}}" class="privacy-item">
        <view wx:if="{{block.title}}" class="privacy-item-t">{{block.title}}</view>
        <view wx:for="{{block.paras}}" wx:for-item="p" wx:key="_k" class="privacy-p">
          <text wx:if="{{p.strong}}" class="privacy-strong">{{p.strong}}</text>{{p.text}}
        </view>
      </view>

      <!-- 普通段落（含「· 」列表行） -->
      <view wx:elif="{{block.t === 'para'}}">
        <view wx:for="{{block.paras}}" wx:for-item="p" wx:key="_k" class="privacy-p">
          <text wx:if="{{p.strong}}" class="privacy-strong">{{p.strong}}</text>{{p.text}}
        </view>
      </view>

      <!-- 灰底补充说明 -->
      <view wx:elif="{{block.t === 'note'}}" class="privacy-p privacy-note">{{block.text}}</view>

    </block>
  </view>

  <view class="privacy-footer safe-bottom">
    <view class="caption">{{doc.footer}}</view>
  </view>

</view>

<!-- 品牌提示条：showSuccess/showError/showApiError 的渲染载体（util.js 自动路由） -->
<brand-toast id="brandToast" />

/* pages/role/role.wxss */
.role-page {
  padding-top: 48rpx;
  padding-bottom: 48rpx;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

.role-header {
  margin-bottom: 56rpx;
}

.role-subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
}

.role-cards {
  flex: 1;
}

.role-card {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s ease;
  position: relative;
}

.role-card-selected {
  border-color: var(--color-accent);
  background: var(--color-card-inner);
  box-shadow: 0 0 0 6rpx var(--color-accent-soft);
}

.role-emoji {
  font-size: 80rpx;
  line-height: 1;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.role-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.role-name {
  margin-bottom: 8rpx;
}

.role-desc {
  font-size: 26rpx;
}

.role-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.role-check-icon {
  color: var(--color-on-accent);
  font-size: 28rpx;
  font-weight: 700;
}

.role-footer {
  padding-top: 32rpx;
  margin-top: auto;
}

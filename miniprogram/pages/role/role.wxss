/* pages/role/role.wxss */
.role-page {
  padding-top: var(--space-6);
  padding-bottom: var(--space-6);
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

.role-header {
  margin-bottom: var(--space-8);
}

.role-subtitle {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--text-body-sm);
  color: var(--color-text-secondary);
  line-height: var(--lh-normal);
}

.role-cards {
  flex: 1;
}

.role-card {
  display: flex;
  align-items: center;
  background: var(--surface-card);
  border-radius: var(--radius-lg);
  padding: var(--space-5) var(--space-4);
  margin-bottom: var(--space-3);
  border: 3rpx solid transparent;
  transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  position: relative;
  box-shadow: var(--elev-1);
}

/* 卡片按压反馈：旧版点了毫无反应，是全组交互质感最弱的一处 */
.role-card-press {
  transform: scale(0.98);
  opacity: 0.9;
}

.role-card-selected {
  border-color: var(--color-accent);
  background: var(--surface-sunken);
  box-shadow: 0 0 0 6rpx var(--color-accent-soft);
}

.role-icon-img {
  width: 84rpx;
  height: 84rpx;
  margin-right: var(--space-4);
  flex-shrink: 0;
}

.role-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.role-name {
  margin-bottom: var(--space-1);
}

.role-desc {
  font-size: var(--text-body-sm);
  color: var(--color-text-secondary);
  line-height: var(--lh-normal);
}

.role-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.role-check-icon {
  color: var(--color-on-accent);
  font-size: var(--text-body-sm);
  font-weight: var(--weight-bold);
}

.role-footer {
  padding-top: var(--space-4);
  margin-top: auto;
}

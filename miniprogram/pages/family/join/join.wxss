/* pages/family/join/join.wxss */
.join-page {
  padding-top: var(--space-6);
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  box-sizing: border-box;
}

.join-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--space-10);
}

.join-title {
  margin-bottom: var(--space-2);
}

.join-tip {
  font-size: var(--text-body-sm);
  color: var(--color-text-secondary);
  line-height: var(--lh-normal);
}

/* 6位字母数字输入 */
.code-input-wrapper {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: var(--space-8);
}

.code-boxes {
  display: flex;
  justify-content: space-between;
  width: 560rpx;
}

.code-box {
  width: 76rpx;
  height: 84rpx;
  background: var(--surface-sunken);
  border: 3rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  box-sizing: border-box;
}

.code-box-focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 4rpx var(--color-accent-soft);
}

.code-box-filled {
  border-color: var(--color-accent);
}

.code-digit {
  font-size: var(--text-num);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
}

.code-hidden-input {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  /* 部分安卓机型聚焦后原生层会无视 opacity 直接画出文字（与装饰框形成错位重影），
     文字与光标再设为透明双保险 */
  color: transparent;
  caret-color: transparent;
  background: transparent;
  border: none;
  z-index: 10;
}

.join-loading {
  margin-top: var(--space-6);
}

.join-loading-text {
  font-size: var(--text-caption);
  color: var(--color-text-tertiary);
  text-align: center;
}

/* 主操作按钮：与全 App 一致撑满容器（旧版 560rpx 定宽与其他页按钮并排穿帮） */
.join-footer {
  width: 100%;
  margin-top: var(--space-1);
}

/* 粘贴提示上移到按钮上方：这是本页唯一的快捷操作说明 */
.join-hint {
  margin-bottom: var(--space-3);
  text-align: center;
  font-size: var(--text-caption);
  color: var(--color-text-tertiary);
  line-height: var(--lh-normal);
}

<!--pages/family/join/join.wxml-->
<view class="container join-page {{themeClass}}">
  <view class="join-header">
    <view class="title-h1 join-title">{{fromInvite ? '收到邀请' : '加入家庭'}}</view>
    <view class="join-tip">
      {{fromInvite ? '正在通过邀请加入这个家庭，请稍候…' : '请输入金牌大厨分享的6位家庭码'}}
    </view>
  </view>

  <!-- 6位字母数字输入区域（长按可粘贴剪贴板中的邀请码） -->
  <view class="code-input-wrapper" bindtap="onTapInput" bindlongpress="onPasteFromClipboard">
    <view class="code-boxes">
      <view
        class="code-box {{index === focusIndex && inputFocus ? 'code-box-focus' : ''}} {{digits[index] ? 'code-box-filled' : ''}}"
        wx:for="{{digits}}"
        wx:key="index"
      >
        <text class="code-digit">{{item}}</text>
      </view>
    </view>
    <!-- 隐藏的输入框 -->
    <input
      class="code-hidden-input"
      type="text"
      maxlength="6"
      focus="{{inputFocus}}"
      value="{{codeValue}}"
      bindinput="onInput"
      bindblur="onInputBlur"
      confirm-type="done"
      cursor-spacing="200"
    />
  </view>

  <view class="join-loading" wx:if="{{loading}}">
    <view class="join-loading-text">正在加入...</view>
  </view>

  <!-- 主操作按钮：未满 6 位时禁用，既是进度提示也是兜底入口 -->
  <view class="join-footer safe-bottom">
    <view wx:if="{{!fromInvite}}" class="join-hint">长按粘贴邀请码，或直接输入 · 输满自动加入</view>
    <button
      class="btn btn-primary btn-block {{codeValue.length === 6 && !loading ? '' : 'btn-disabled'}}"
      disabled="{{codeValue.length !== 6 || loading}}"
      bindtap="onSubmitTap"
    >
      {{loading ? '加入中...' : (fromInvite ? '确认加入' : '加入家庭')}}
    </button>
    <view wx:if="{{fromInvite}}" class="join-hint">若自动加入未完成，可点击上方按钮重试</view>
  </view>
</view>

<!-- 隐私协议授权弹窗（PRIV-001） -->
<privacy-popup />

<!-- 品牌提示条：showSuccess/showError/showApiError 的渲染载体（util.js 自动路由） -->
<brand-toast id="brandToast" />

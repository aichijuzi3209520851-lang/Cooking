/* pages/family/manage/manage.wxss */
.manage-page {
  padding-top: var(--space-4);
  padding-bottom: var(--space-6);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 家庭信息卡片 */
.family-card {
  padding: var(--space-5) var(--space-4);
}

.family-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-4);
}

.family-name {
  font-size: var(--text-h2);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  flex: 1;
}

.family-code-section {
  background: var(--surface-sunken);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-3);
  transition: opacity var(--dur-fast) var(--ease-out);
}

.family-code-section:active {
  opacity: 0.7;
}

/* 邀请家人：分享卡片入口（open-type=share）。
   原生 button 的 UA 样式对 width/margin 带 !important，须同级覆盖才能撑满卡片 */
.invite-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  box-sizing: border-box;
  height: 96rpx;
  margin-top: var(--space-1);
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
  color: var(--color-on-accent);
  font-size: var(--text-body);
  font-weight: var(--weight-semibold);
  box-shadow: var(--elev-accent);
  transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
}

.invite-btn::after {
  border: none;
}

.invite-btn-hover {
  opacity: 0.88;
  transform: scale(0.98);
}

.invite-hint {
  margin-top: var(--space-2);
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: var(--text-caption);
  line-height: var(--lh-normal);
}

.family-code-label {
  margin-bottom: var(--space-1);
}

.family-code {
  font-size: var(--text-num);
  font-weight: var(--weight-black);
  color: var(--color-accent);
  letter-spacing: 16rpx;
  /* 补偿末字符后的字距，使视觉居中 */
  text-indent: 16rpx;
  text-align: center;
}

.family-code-pulse {
  animation: pulse 0.3s ease;
}

/* 区域 */
.section {
  margin-top: var(--space-5);
}

/* 区块标题与全局规格一致（h2 40 bold）；旧版覆写成 26rpx 灰字导致三卡层级全靠阴影硬撑 */
.section-title {
  padding: 0 var(--space-1) var(--space-2);
  font-size: var(--text-h2);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
}

/* 家庭列表 */
.family-list-card {
  padding: 0;
  overflow: hidden;
}

.family-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4);
  border-bottom: 1rpx solid var(--color-separator);
  transition: background var(--dur-fast) var(--ease-out);
}

.family-list-item:last-child {
  border-bottom: none;
}

.family-list-item:active {
  background: var(--surface-sunken);
}

.family-list-item-active {
  background: var(--color-accent-soft);
}

.family-list-info {
  flex: 1;
}

.family-list-name {
  font-size: var(--text-body);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-1);
}

.family-list-role {
  font-size: var(--text-caption);
}

.family-list-check {
  font-size: var(--icon-xs);
  font-weight: var(--weight-bold);
  color: var(--color-accent);
}

/* 成员列表 */
.member-list-card {
  padding: 0;
  overflow: hidden;
}

.member-item {
  display: flex;
  align-items: center;
  padding: var(--space-3) var(--space-4);
  border-bottom: 1rpx solid var(--color-separator);
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: var(--space-3);
}

.member-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.member-avatar-text {
  font-size: var(--icon-xs);
  font-weight: var(--weight-semibold);
  color: var(--color-text-inverse);
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.member-name {
  font-size: var(--text-body);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-right: var(--space-2);
}

.member-badge {
  margin-right: 8rpx;
}

.member-self-tag {
  font-size: var(--text-caption);
  color: var(--color-text-secondary);
}

.member-actions {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-shrink: 0;
}

.member-action-btn {
  font-size: var(--text-caption);
  font-weight: var(--weight-medium);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-pill);
  line-height: 1.4;
  position: relative;
}

/* 高危操作（移除成员）热区外扩，避免误触邻居 */
.member-action-btn::after {
  content: '';
  position: absolute;
  top: -10rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -10rpx;
}

.member-action-transfer {
  color: var(--color-text-secondary);
  background: var(--surface-sunken);
}

.member-action-toggle {
  color: var(--color-accent-deep);
  background: var(--color-accent-soft);
}

.member-action-remove {
  color: var(--color-danger);
  background: var(--color-danger-soft);
}

.member-action-btn:active {
  opacity: 0.6;
}

/* 告别按钮：暖红描边胶囊，委婉不刺眼 */
.exit-section {
  margin-top: var(--space-8);
  display: flex;
  justify-content: center;
}

.exit-btn {
  min-width: 420rpx;
  height: 96rpx;
  line-height: 92rpx;
  padding: 0 var(--space-8);
  background: transparent;
  border: 2rpx solid var(--color-danger-border);
  border-radius: var(--radius-pill);
  color: var(--color-danger) !important;
  font-size: var(--text-body);
  font-weight: var(--weight-semibold);
}

.exit-btn-hover {
  opacity: 0.75;
  transform: scale(0.98);
}

/* 禁用态：可读灰（描边转中性，文字保持可读） */
.exit-btn[disabled] {
  opacity: 1;
  color: var(--color-text-tertiary) !important;
  border-color: var(--color-border);
}

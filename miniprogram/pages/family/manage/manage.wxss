/* pages/family/manage/manage.wxss */
.manage-page {
  padding-top: 32rpx;
  padding-bottom: 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 家庭信息卡片 */
.family-card {
  padding: 40rpx 32rpx;
}

.family-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.family-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  flex: 1;
}

.family-code-section {
  background: var(--color-card-inner);
  border-radius: var(--radius-md);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.family-code-label {
  margin-bottom: 8rpx;
}

.family-code {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-accent);
  letter-spacing: 16rpx;
  text-align: center;
}

/* 区域 */
.section {
  margin-top: 32rpx;
}

.section-title {
  padding: 0 8rpx 16rpx;
  font-size: 26rpx;
}

/* 家庭列表 */
.family-list-card {
  padding: 0;
  overflow: hidden;
}

.family-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-separator);
  transition: background 0.2s ease;
}

.family-list-item:last-child {
  border-bottom: none;
}

.family-list-item:active {
  background: var(--color-bg-tertiary);
}

.family-list-item-active {
  background: var(--color-accent-soft);
}

.family-list-info {
  flex: 1;
}

.family-list-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 6rpx;
}

.family-list-role {
  font-size: 24rpx;
}

.family-list-check {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-accent);
}

/* 成员列表 */
.member-list-card {
  padding: 0;
  overflow: hidden;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--color-separator);
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.member-avatar-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.member-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-right: 12rpx;
}

.member-badge {
  margin-right: 8rpx;
}

.member-self-tag {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.member-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.member-action-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-pill);
  line-height: 1.4;
}

.member-action-toggle {
  color: var(--color-accent);
  background: var(--color-accent-soft);
}

.member-action-remove {
  color: var(--color-primary-red);
  background: rgba(255, 59, 48, 0.1);
}

.member-action-btn:active {
  opacity: 0.6;
}

/* 退出按钮 */
.exit-section {
  margin-top: 56rpx;
  display: flex;
  justify-content: center;
}

.exit-btn {
  color: var(--color-primary-red) !important;
  font-size: 30rpx;
  font-weight: 500;
}

.exit-btn[disabled] {
  opacity: 0.4;
}

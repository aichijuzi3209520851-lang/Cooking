/* pages/welcome/welcome.wxss */
.welcome-page {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  min-height: 100vh;
  padding: 0 64rpx;
  padding-top: 120rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 80rpx);
  box-sizing: border-box;
  /* 与登录页同一渐变氛围（上一页是光晕+漂浮食材，这一页素底会像换了 App） */
  background:
    linear-gradient(180deg, var(--surface-page) 0%, var(--surface-card) 55%, var(--color-cream) 100%),
    url('/images/brand/paper-texture.jpg');
  background-size: 100% 100%, 360rpx 323rpx;
  background-blend-mode: normal, multiply;
}

.welcome-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  justify-content: center;
}

.welcome-mark-img {
  width: 168rpx;
  height: 168rpx;
  margin-bottom: var(--space-6);
}

.welcome-title {
  font-size: var(--text-display);
  font-weight: var(--weight-black);
  color: var(--color-text-primary);
  letter-spacing: 2rpx;
  line-height: var(--lh-tight);
  margin-bottom: var(--space-3);
}

.welcome-title-highlight {
  color: var(--color-accent);
}

.welcome-subtitle {
  font-size: var(--text-body);
  color: var(--color-text-secondary);
  line-height: var(--lh-normal);
  letter-spacing: 1rpx;
}

.welcome-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.welcome-btn {
  margin-bottom: var(--space-3);
}

.welcome-footer {
  font-size: var(--text-caption);
  color: var(--color-text-tertiary);
  margin-top: var(--space-3);
  text-align: center;
  letter-spacing: 2rpx;
}

/* 登录失败提示 + 重试 */
.welcome-login-error {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.welcome-login-error-text {
  font-size: var(--text-body-sm);
  color: var(--color-danger);
  margin-bottom: var(--space-4);
  text-align: center;
  line-height: var(--lh-normal);
}

<!--pages/welcome/welcome.wxml-->
<view class="welcome-page {{themeClass}}">
  <view class="welcome-content">
    <view class="welcome-emoji">🍳</view>
    <view class="welcome-title">今天<text class="welcome-title-highlight">吃啥</text></view>
    <view class="welcome-subtitle">告诉掌勺的你想吃什么</view>
  </view>

  <view class="welcome-actions">
    <button class="btn btn-primary btn-block welcome-btn" bindtap="onCreateFamily">
      创建家庭
    </button>
    <button class="btn btn-secondary btn-block welcome-btn" bindtap="onJoinFamily">
      加入家庭
    </button>
    <view class="welcome-footer">和家人一起决定今天的菜单</view>
  </view>
</view>

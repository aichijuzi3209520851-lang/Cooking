<!--pages/profile/profile.wxml-->
<view class="container profile-page {{themeClass}}">

  <!-- 用户信息卡片：轻触头像换头像，轻触昵称改昵称 -->
  <view class="profile-card">
    <view class="profile-avatar-wrap">
      <view class="profile-avatar" style="{{avatarUrl ? '' : avatarStyle}}">
        <image
          wx:if="{{avatarUrl}}"
          class="profile-avatar-img"
          src="{{avatarUrl}}"
          mode="aspectFill"
        />
        <text wx:else class="profile-avatar-text">{{avatarText}}</text>
      </view>
      <!-- 隐形按钮覆盖在头像上，只负责接收 chooseAvatar 点击 -->
      <button
        class="profile-avatar-overlay"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
        aria-label="更换头像"
      ></button>
    </view>
    <view class="profile-info">
      <view class="profile-name-row" bindtap="onEditNickname" hover-class="profile-name-hover">
        <text class="profile-name">{{nickname}}</text>
      </view>
      <view class="profile-meta-row">
        <view class="badge {{isChef ? 'badge-chef' : 'badge-eater'}}">
          {{roleEmoji}} {{roleName}}
        </view>
        <text class="profile-family" wx:if="{{currentFamily}}">{{currentFamily.name}}</text>
        <text class="profile-family" wx:else>暂未加入家庭</text>
      </view>
    </view>
  </view>

  <!-- 第一组：家庭 -->
  <view class="section">
    <view class="section-header">家庭</view>
    <view class="group-card">
      <view class="list-item" bindtap="onFamilyManage">
        <text class="list-item-label">家庭管理</text>
        <text class="list-item-arrow">›</text>
      </view>
      <view
        wx:if="{{isChef}}"
        class="list-item list-item-bordered"
        bindtap="onDishList"
      >
        <text class="list-item-label">菜品库管理</text>
        <text class="list-item-arrow">›</text>
      </view>
      <view
        class="list-item {{isChef ? 'list-item-bordered' : ''}}"
        bindtap="onHistory"
      >
        <text class="list-item-label">历史记录</text>
        <text class="list-item-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 第二组：偏好 -->
  <view class="section">
    <view class="section-header">偏好</view>
    <view class="group-card">
      <view class="list-item" bindtap="onSwitchRole">
        <text class="list-item-label">切换身份</text>
        <view class="list-item-right">
          <text class="list-item-value">{{roleEmoji}} {{roleName}}</text>
          <text class="list-item-arrow">›</text>
        </view>
      </view>
      <view class="list-item list-item-bordered" bindtap="onNotifySettings">
        <text class="list-item-label">通知设置</text>
        <text class="list-item-arrow">›</text>
      </view>
      <view class="list-item list-item-bordered" bindtap="onThemeSettings">
        <text class="list-item-label">主题设置</text>
        <text class="list-item-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 第三组：其他 -->
  <view class="section">
    <view class="section-header">其他</view>
    <view class="group-card">
      <view class="list-item" bindtap="onAbout">
        <text class="list-item-label">关于</text>
        <text class="list-item-arrow">›</text>
      </view>
    </view>
  </view>

</view>

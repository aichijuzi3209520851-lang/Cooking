/* pages/profile/profile.wxss */
.profile-page {
  padding-top: 32rpx;
  padding-bottom: 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 用户信息卡片 ===== */
.profile-card {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx;
  margin-bottom: 32rpx;
}

/* 头像区：可见头像用固定尺寸 image（保证正圆），chooseAvatar 按钮做隐形覆盖层 */
.profile-avatar-wrap {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  margin: 0 24rpx 0 0;
  flex-shrink: 0;
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: block;
}

/* 隐形覆盖按钮：铺满头像接收点击，本身零视觉（不受微信 button 默认样式干扰） */
.profile-avatar-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 2;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 50%;
}

.profile-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.profile-avatar-text {
  font-size: 44rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  /* 单行制：昵称 + 编辑笔，不与徽章混排（徽章与家庭名在第二行） */
  flex-wrap: nowrap;
  padding: 12rpx 0;
  margin: -12rpx 0;
}

.profile-name-hover {
  opacity: 0.75;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.3;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 第二行：身份徽章 · 家庭名 */
.profile-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  min-width: 0;
}

.profile-family {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 分组列表 ===== */
.section {
  margin-bottom: 32rpx;
}

.section-header {
  padding: 0 16rpx 14rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.group-card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  transition: background 0.15s ease;
}

.list-item:active {
  background: var(--color-bg-tertiary);
}

.list-item-bordered {
  position: relative;
}

.list-item-bordered::before {
  content: '';
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 0;
  height: 1rpx;
  background: var(--color-separator);
}

.list-item-label {
  font-size: 30rpx;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.list-item-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.list-item-value {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 行内右侧组合（徽标 + 箭头） */
.list-item-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 行内引导徽标：中性灰，待办语义（BADGE-002） */
.row-badge {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--color-bg-tertiary);
  color: var(--color-text-secondary);
  font-size: 20rpx;
  font-weight: 500;
}

.list-item-arrow {
  font-size: 36rpx;
  color: var(--color-text-tertiary);
  line-height: 1;
  margin-left: 4rpx;
}

/* pages/profile/profile.wxss */
.profile-page {
  padding-top: 32rpx;
  padding-bottom: 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 用户信息卡片 ===== */
.profile-card {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx;
  margin-bottom: 32rpx;
}

/* 头像即按钮：微信头像昵称填写能力（open-type=chooseAvatar） */
.profile-avatar-btn {
  width: 96rpx;
  height: 96rpx;
  padding: 0;
  margin: 0 24rpx 0 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  line-height: 1;
  flex-shrink: 0;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar-hover {
  opacity: 0.8;
  transform: scale(0.96);
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 头像右下角相机角标：提示可自定义 */
.profile-avatar-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--color-card);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
  font-size: 18rpx;
  line-height: 34rpx;
  text-align: center;
}

.profile-avatar {
  position: relative;
}

.profile-avatar-img {
  width: 100%;
  height: 100%;
}

.profile-avatar-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 12rpx 0;
  margin: -12rpx 0;
}

.profile-name-hover {
  opacity: 0.75;
}

.profile-name-edit {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-left: 8rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-right: 16rpx;
  line-height: 1.3;
}

.profile-badge {
  flex-shrink: 0;
}

.profile-family {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 10rpx;
  line-height: 1.4;
}

/* ===== 分组列表 ===== */
.section {
  margin-bottom: 32rpx;
}

.section-header {
  padding: 0 16rpx 14rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.group-card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  transition: background 0.15s ease;
}

.list-item:active {
  background: var(--color-bg-tertiary);
}

.list-item-bordered {
  position: relative;
}

.list-item-bordered::before {
  content: '';
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 0;
  height: 1rpx;
  background: var(--color-separator);
}

.list-item-label {
  font-size: 30rpx;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.list-item-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.list-item-value {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.list-item-arrow {
  font-size: 36rpx;
  color: var(--color-text-tertiary);
  line-height: 1;
  margin-left: 4rpx;
}

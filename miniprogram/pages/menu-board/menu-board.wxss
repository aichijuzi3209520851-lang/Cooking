/* pages/menu-board/menu-board.wxss */
.board-page {
  min-height: 100vh;
  padding: var(--space-3) var(--space-4) var(--space-8);
  box-sizing: border-box;

  /* 餐次标签：固定语义色（不随主题家族漂移，避免橙/绿被强调色冲淡） */
  --meal-breakfast-bg: rgba(240, 130, 30, 0.12);
  --meal-breakfast-text: #B4690E;
  --meal-lunch-bg: rgba(31, 147, 96, 0.12);
  --meal-lunch-text: #1F7D54;
}

.board-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--space-2) var(--space-1) var(--space-3);
}

.board-title {
  font-weight: var(--weight-bold);
}

.board-sub {
  color: var(--color-text-secondary);
}

.board-state {
  padding: calc(var(--space-12) + var(--space-3)) 0;
  text-align: center;
  color: var(--color-text-secondary);
}

.board-card {
  background: var(--surface-card);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-3);
  box-shadow: var(--shadow-card);
}

.board-section-title {
  font-size: var(--text-h3);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

/* 全家总单 */
.total-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.total-item {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  background: var(--color-card-inner);
  border-radius: var(--radius-pill);
  padding: var(--space-1) var(--space-3);
}

.total-name {
  font-size: var(--text-body-sm);
  color: var(--color-text-primary);
}

.total-count {
  font-size: var(--text-mini);
  color: var(--color-accent);
  font-weight: var(--weight-bold);
}

/* 按提交人分组 */
.sub-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-2);
}

.sub-name {
  font-size: var(--text-h3);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.sub-meta {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.meal-tag {
  font-size: var(--text-mini);
  padding: 4rpx var(--space-2);
  border-radius: var(--radius-pill);
  background: var(--color-accent-soft);
  color: var(--color-accent);
  font-weight: var(--weight-semibold);
}

.meal-breakfast {
  background: var(--meal-breakfast-bg);
  color: var(--meal-breakfast-text);
}

.meal-lunch {
  background: var(--meal-lunch-bg);
  color: var(--meal-lunch-text);
}

.meal-dinner {
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

.sub-time {
  font-size: var(--text-mini);
  color: var(--color-text-tertiary);
}

.sub-dishes {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
}

.sub-dish {
  font-size: var(--text-body-sm);
  color: var(--color-text-secondary);
  background: var(--color-card-inner);
  border-radius: var(--radius-xs);
  padding: var(--space-1) var(--space-2);
}

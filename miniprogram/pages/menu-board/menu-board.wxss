/* pages/menu-board/menu-board.wxss
 * 四 tab 中「答案页」：hero 与点菜/汇总同一语言（淡染 + h1），
 * 「今晚全家想吃」答案卡用强调色淡染突出，提交明细弱化为次级层。
 */

.board-page {
  min-height: 100vh;
  padding-bottom: var(--space-8);
  box-sizing: border-box;

  /* 餐次标签：固定语义色（不随主题家族漂移，避免橙/绿被强调色冲淡）；
     深色主题在下方 .theme-dark 块提亮文字色保证对比度 */
  --meal-breakfast-bg: rgba(240, 130, 30, 0.12);
  --meal-breakfast-text: #B4690E;
  --meal-lunch-bg: rgba(31, 147, 96, 0.12);
  --meal-lunch-text: #1F7D54;
}

/* 深色主题：餐次文字提亮到 AA 可读档 */
.theme-dark.board-page,
.board-page.theme-dark {
  --meal-breakfast-text: #E8A15C;
  --meal-lunch-text: #7BC96F;
}

/* ===== 顶部英雄区（与 menu/summary 同款：全出血淡染 + 底部大圆角） ===== */
.board-hero {
  margin: 0 calc(var(--space-4) * -1) var(--space-4);
  padding: var(--space-3) var(--space-4) var(--space-4);
  background: linear-gradient(160deg, var(--tint-1) 0%, var(--tint-2) 55%, var(--tint-3) 100%);
  border-bottom-left-radius: var(--radius-xl);
  border-bottom-right-radius: var(--radius-xl);
}

.board-title {
  font-size: var(--text-h1);
  font-weight: var(--weight-black);
  color: var(--color-text-primary);
  letter-spacing: -0.5rpx;
  line-height: var(--lh-tight);
}

.board-sub {
  margin-top: var(--space-1);
  font-size: var(--text-caption);
  color: var(--color-text-secondary);
}

.board-state {
  padding: calc(var(--space-12) + var(--space-3)) 0;
  text-align: center;
  color: var(--color-text-secondary);
}

.board-retry {
  margin-top: var(--space-3);
  display: inline-flex;
  align-items: center;
  height: 68rpx;
  padding: 0 var(--space-5);
  border-radius: var(--radius-pill);
  background: var(--color-accent-soft);
  color: var(--color-accent-deep);
  font-size: var(--text-caption);
  font-weight: var(--weight-semibold);
}

/* ===== 今晚的答案：全家总单（强调卡） ===== */
.board-answer {
  background: var(--color-accent-wash);
  border: 1rpx solid var(--color-accent-soft);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-6);
  box-sizing: border-box;
}

.answer-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-3);
}

.answer-title {
  font-size: var(--text-h2);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
}

.answer-count {
  font-size: var(--text-caption);
  color: var(--color-text-secondary);
}

.total-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

/* 菜名 chip：卡上浮起的白色胶囊，被点人数用数字强调色 */
.total-item {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  background: var(--surface-raised);
  border-radius: var(--radius-pill);
  padding: var(--space-1) var(--space-3);
  box-shadow: var(--elev-1);
}

/* 卡片内菜品小缩略图：有配图的菜在标签左侧显示圆角小图 */
.total-thumb {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-xs);
  flex-shrink: 0;
  background: var(--surface-sunken);
}

/* 「全家都想吃」整卡可点反馈 */
.answer-hover {
  opacity: 0.92;
  transform: scale(0.995);
}

/* 总单里每道菜的「谁想吃」头像组：与人数计数间留出呼吸位 */
.total-avatars {
  margin-left: var(--space-1);
}

/* ===== 菜品图片画廊弹层 ===== */
.gallery-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(20, 16, 10, 0.55);
  display: flex;
  align-items: flex-end;
}

.gallery-panel {
  width: 100%;
  max-height: 78vh;
  box-sizing: border-box;
  background: var(--surface-card);
  border-top-left-radius: var(--radius-xl);
  border-top-right-radius: var(--radius-xl);
  padding: var(--space-4) var(--space-4) calc(var(--space-4) + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
}

.gallery-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-3);
}

.gallery-title {
  font-size: var(--text-h2);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.gallery-sub {
  font-size: var(--text-caption);
  color: var(--color-text-secondary);
}

.gallery-scroll {
  max-height: 56vh;
}

.gallery-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.gallery-cell {
  width: calc((100% - var(--space-3) * 2) / 3);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-1);
}

.gallery-img {
  width: 100%;
  height: 0;
  padding-top: 100%;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: var(--surface-sunken);
  overflow: hidden;
  position: relative;
}

.gallery-img image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 无配图的菜：分类表情占位（<text> 不支持 flex，用 view 包一层才能居中） */
.gallery-fallback {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-fallback-emoji {
  font-size: 88rpx;
  line-height: 1;
  opacity: 0.85;
}

.gallery-cell-name {
  font-size: var(--text-mini);
  color: var(--color-text-primary);
  font-weight: var(--weight-medium);
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gallery-cell-count {
  font-size: var(--text-mini);
  color: var(--color-num-strong);
  font-weight: var(--weight-bold);
}

.gallery-close {
  margin-top: var(--space-4);
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  background: var(--color-accent-soft);
  color: var(--color-accent-deep);
  font-size: var(--text-body-sm);
  font-weight: var(--weight-semibold);
  letter-spacing: 2rpx;
}

.total-name {
  font-size: var(--text-body-sm);
  font-weight: var(--weight-medium);
  color: var(--color-text-primary);
}

.total-count {
  font-size: var(--text-mini);
  color: var(--color-num-strong);
  font-weight: var(--weight-bold);
}

/* ===== 提交明细 ===== */
.board-detail-title {
  margin-bottom: var(--space-3);
}

.board-card {
  background: var(--surface-card);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
  box-shadow: var(--elev-1);
  box-sizing: border-box;
}

.sub-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-2);
}

/* 提交人头像 + 昵称（NOTIFY-004）：表明这份菜单是谁交的 */
.sub-who {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
}

.sub-avatar {
  flex-shrink: 0;
}

.sub-name {
  font-size: var(--text-h3);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.sub-meta {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.meal-tag {
  font-size: var(--text-mini);
  padding: 4rpx var(--space-2);
  border-radius: var(--radius-pill);
  background: var(--color-accent-soft);
  color: var(--color-accent);
  font-weight: var(--weight-semibold);
}

.meal-breakfast {
  background: var(--meal-breakfast-bg);
  color: var(--meal-breakfast-text);
}

.meal-lunch {
  background: var(--meal-lunch-bg);
  color: var(--meal-lunch-text);
}

.meal-dinner {
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

.sub-time {
  font-size: var(--text-mini);
  color: var(--color-text-tertiary);
}

.sub-dishes {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
}

.sub-dish {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--text-body-sm);
  color: var(--color-text-secondary);
  background: var(--surface-sunken);
  border-radius: var(--radius-xs);
  padding: var(--space-1) var(--space-2);
}

/* 大厨撤菜 ×（NOTIFY-004）：小红点级弱存在，按下去才升级为弹窗 */
.sub-dish-remove {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin: -4rpx -6rpx -4rpx 0;
  border-radius: 50%;
  font-size: 30rpx;
  line-height: 1;
  color: var(--color-text-tertiary);
}

.sub-dish-remove:active {
  color: var(--color-primary-red);
  background: rgba(224, 32, 32, 0.10);
}

/* ===== 加载骨架（形状与 board-card 对齐） ===== */
.skeleton-card {
  background: var(--surface-card);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
  box-shadow: var(--elev-1);
  box-sizing: border-box;
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--radius-xs);
  background: var(--surface-sunken);
}

.skeleton-line-title {
  width: 45%;
  margin-bottom: var(--space-3);
}

.skeleton-chip-row {
  display: flex;
  gap: var(--space-2);
}

.skeleton-chip {
  width: 160rpx;
  height: 56rpx;
  border-radius: var(--radius-pill);
  background: var(--surface-sunken);
}

.skeleton-shimmer {
  animation: skeleton-pulse 1.2s ease-in-out infinite;
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

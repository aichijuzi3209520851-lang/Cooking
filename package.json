{
  "name": "family-dining-miniprogram",
  "version": "1.3.0",
  "private": true,
  "description": "筷点吃饭：家庭就餐决策小程序（微信原生小程序 + CloudBase 云开发）",
  "scripts": {
    "check:syntax": "node scripts/check-syntax.js",
    "lint": "node scripts/lint.js",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/contracts/*.test.js\" \"tests/smoke/*.test.js\" \"tests/whitebox/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "check:contracts": "node --test \"tests/contracts/*.test.js\"",
    "predeploy": "npm run check:syntax && npm run lint && npm test",
    "test:coverage": "node --test --experimental-test-coverage \"tests/unit/*.test.js\" \"tests/contracts/*.test.js\" \"tests/smoke/*.test.js\" \"tests/whitebox/*.test.js\"",
    "test:e2e": "node scripts/e2e-smoke.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "miniprogram-automator": "^0.12.1"
  }
}
